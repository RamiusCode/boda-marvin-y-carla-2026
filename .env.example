# Copiá este archivo como .env y pegá los valores reales.
# Se sacan de: supabase.com -> tu proyecto -> Project Settings -> API Keys
#
# El prefijo es PUBLIC_, no NEXT_PUBLIC_: Astro solo expone al navegador
# las variables que empiezan con PUBLIC_.
#
# Estas dos claves son publicas por diseño: viajan al navegador de cada
# invitado. Lo que protege los datos son las politicas RLS de la base.
# La clave service_role NUNCA va aca.

PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxx
