---
// src/components/Pase.astro
// Tarjeta con los pases reservados para el invitado y, debajo, el pedido de
// confirmación con el botón a WhatsApp.
// ── DATOS EDITABLES ───────────────────────────────────────────
const reservado = "Hemos reservado";
const honor = "en tu honor";

const tituloConfirmar = "Confirmación de Asistencia";
const aviso = [
    "Tu presencia es muy importante, no",
    "olvides confirmar tu asistencia.",
];
const textoBoton = "Confirmar Asistencia";
const yaConfirmado = "¡Gracias! Ya confirmaste tu asistencia.";

// WhatsApp de los novios (código de país + número, sin + ni espacios).
const whatsapp = "59163001482";
const mensaje =
    "Confirmo la asistencia a la boda de Marvin y Carla. Nos vemos el sábado 9 de enero. ¡Será un placer acompañarlos!";
const enlace = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensaje)}`;
// ──────────────────────────────────────────────────────────────

// El nombre y la cantidad de pases llegan por prop desde las invitaciones
// personalizadas; acá quedan los valores de muestra.
export interface Props {
    invitado?: string;
    pases?: number;
}
const { invitado = "Adriana Candia", pases = 2 } = Astro.props;

const palabraPases = pases === 1 ? "pase" : "pases";
---

<section id="pase" class="relative w-full overflow-hidden px-7 py-14">
    <div id="bloque-pase" class="relative flex flex-col items-center text-center">
        <!-- Tarjeta terracota con los pases -->
        <div class="tarjeta-pase">
            <p class="font-verandah nombre-invitado">{invitado}</p>
            <p class="font-cormorant reservado-pase">{reservado}</p>
            <p class="cantidad-pases">
                {/*
                   El número va en Adelia: Verandah Reverie trae los dígitos
                   bloqueados y dibuja una marca de agua en su lugar.
                */}
                <span class="font-adelia numero-pases">{pases}</span>
                <span class="font-verandah palabra-pases">{palabraPases}</span>
            </p>
            <p class="font-cormorant honor-pase">{honor}</p>
        </div>

        <h2 class="font-dancing titulo-confirmar">{tituloConfirmar}</h2>

        <p class="font-cormorant aviso-confirmar">
            {aviso.map((linea) => <span class="block">{linea}</span>)}
        </p>

        <!--
           Dos caminos, y el script decide cuál mostrar:

           · Con link personalizado → el botón confirma en un toque, sin
             escribir nada: la invitación ya sabe quién es.
           · Sin link (la invitación general que se comparte en un grupo)
             → se queda el enlace a WhatsApp, porque ahí no hay a quién
             marcar en la lista.
        -->
        <button
            id="btn-confirmar"
            type="button"
            class="font-cormorant boton-confirmar"
            hidden
        >
            {textoBoton}
        </button>

        <p id="ya-confirmado" class="font-cormorant confirmado-aviso" hidden>
            <span class="tilde" aria-hidden="true">&#10003;</span>
            <span id="texto-confirmado">{yaConfirmado}</span>
        </p>

        <a
            id="btn-whatsapp"
            href={enlace}
            target="_blank"
            rel="noopener noreferrer"
            class="font-cormorant boton-confirmar"
        >
            {textoBoton}
        </a>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- ✅ MODAL · confirmar asistencia                             -->
<!-- ═══════════════════════════════════════════════════════════ -->
<!--
   El paso intermedio existe por dos razones:

   1. Un toque sin querer dejaba al invitado anotado sin vuelta atrás.
   2. Muestra con qué nombre va a quedar registrado. Si alguien reenvió el
      link, esa persona ve que dice "María Valdés" y se da cuenta antes de
      anotarse en el lugar de otro.
-->
<div id="modal-asistencia" class="modal-pase" hidden>
    <div class="modal-pase-velo" data-cerrar-asistencia></div>

    <div
        class="modal-pase-caja"
        role="dialog"
        aria-modal="true"
        aria-labelledby="titulo-modal-asistencia"
    >
        <h3
            id="titulo-modal-asistencia"
            class="font-great-vibes modal-pase-titulo"
        >
            ¿Confirmás tu asistencia?
        </h3>

        <p class="font-cormorant modal-pase-texto">Vas a confirmar como</p>

        <p class="font-verandah nombre-invitado modal-pase-nombre">
            {invitado}
        </p>

        <p class="font-cormorant modal-pase-pases">
            <span class="numero-pases">{pases}</span>
            <span class="palabra-pases">{palabraPases}</span>
        </p>

        <div class="modal-pase-botones">
            <button
                type="button"
                class="font-cormorant boton-cancelar"
                data-cerrar-asistencia
            >
                Cancelar
            </button>
            <button
                id="btn-confirmar-si"
                type="button"
                class="font-cormorant boton-confirmar"
            >
                Sí, confirmo
            </button>
        </div>
    </div>
</div>

<style>
    .tarjeta-pase {
        position: relative;
        overflow: hidden;
        width: 100%;
        max-width: 330px;
        padding: 2.2rem 1.5rem 2.6rem;
        /* Como el modelo: esquinas apenas redondeadas arriba y el borde de
           abajo curvado, no recto. */
        border-radius: 12px 12px 50% 50% / 12px 12px 26px 26px;
        background: #b45733;
        box-shadow: 0 12px 26px rgba(90, 40, 22, 0.22);
    }

    .nombre-invitado {
        color: #fdf6ee;
        font-size: clamp(1.6rem, 7.2vw, 2rem);
        line-height: 1.3;
    }

    /* Mismo cuerpo que los textos de las otras secciones, para no descuadrar */
    .reservado-pase,
    .honor-pase {
        color: #f6e2d3;
        font-size: clamp(1.15rem, 5.3vw, 1.4rem);
        line-height: 1.4;
    }

    .reservado-pase {
        margin-top: 1.1rem;
    }

    .honor-pase {
        margin-top: 0.9rem;
    }

    .cantidad-pases {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 0.35rem;
        margin-top: 0.5rem;
        color: #fdf6ee;
        font-size: clamp(2rem, 9.2vw, 2.6rem);
        line-height: 1.2;
    }

    /* Adelia es de ojo más chico que Verandah: se compensa acá */
    .numero-pases {
        font-size: 0.94em;
    }

    .titulo-confirmar {
        color: #a4482a;
        font-size: clamp(1.7rem, 7.6vw, 2.1rem);
        line-height: 1.3;
        margin-top: 2.6rem;
    }

    .aviso-confirmar {
        color: #7a3418;
        font-size: clamp(1.15rem, 5.3vw, 1.4rem);
        line-height: 1.5;
        margin-top: 0.9rem;
    }

    .boton-confirmar {
        display: inline-block;
        margin-top: 1.6rem;
        padding: 0.75rem 1.9rem;
        border-radius: 10px;
        background: #b45733;
        color: #fdf1e6;
        font-size: clamp(1.05rem, 4.8vw, 1.25rem);
        font-weight: 600;
        letter-spacing: 0.03em;
        box-shadow: 0 6px 16px rgba(90, 40, 22, 0.22);
        transition: transform 0.3s ease;
    }

    .boton-confirmar:hover {
        transform: scale(1.04);
    }

    /* El botón es un <button>, no un <a>: hay que igualar lo que el
       navegador le pone de fábrica */
    button.boton-confirmar {
        border: none;
        cursor: pointer;
        font-family: inherit;
    }

    button.boton-confirmar:disabled {
        opacity: 0.65;
        cursor: default;
        transform: none;
    }

    .boton-confirmar[hidden],
    .confirmado-aviso[hidden] {
        display: none;
    }

    /* El acuse de recibo, en lugar del botón */
    .confirmado-aviso {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.6rem;
        padding: 0.7rem 1.5rem;
        border: 1px solid #b45733;
        border-radius: 10px;
        color: #7a3418;
        font-size: clamp(1rem, 4.5vw, 1.15rem);
        line-height: 1.4;
    }

    .tilde {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.4rem;
        height: 1.4rem;
        flex: none;
        border-radius: 50%;
        background: #b45733;
        color: #fdf1e6;
        font-size: 0.85rem;
    }

    /* ═══ MODAL DE CONFIRMACIÓN ═══ */
    .modal-pase {
        position: fixed;
        inset: 0;
        z-index: 9998;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.2rem;
    }

    /* Explícito: si no, el display:flex de arriba le gana al atributo */
    .modal-pase[hidden] {
        display: none;
    }

    .modal-pase-velo {
        position: absolute;
        inset: 0;
        background: rgba(74, 30, 16, 0.62);
        backdrop-filter: blur(3px);
    }

    .modal-pase-caja {
        position: relative;
        width: 100%;
        max-width: 21rem;
        padding: 2rem 1.6rem 1.7rem;
        border-radius: 10px;
        background: linear-gradient(160deg, #fdf6ee 0%, #f7e9dc 100%);
        box-shadow: 0 24px 60px rgba(60, 24, 12, 0.45);
        text-align: center;
    }

    .modal-pase-titulo {
        color: #a4482a;
        font-size: clamp(1.8rem, 8.2vw, 2.2rem);
        line-height: 1.2;
    }

    .modal-pase-texto {
        color: #a05a3c;
        font-size: clamp(0.95rem, 4.3vw, 1.05rem);
        margin-top: 0.9rem;
    }

    /* El nombre es lo que el invitado tiene que reconocer: va grande */
    .modal-pase-nombre {
        color: #7a3418;
        font-size: clamp(1.7rem, 8vw, 2.1rem);
        line-height: 1.25;
        margin-top: 0.2rem;
    }

    .modal-pase-pases {
        color: #a05a3c;
        font-size: clamp(0.95rem, 4.3vw, 1.05rem);
        font-variant-numeric: lining-nums;
        margin-top: 0.1rem;
    }

    .modal-pase-botones {
        display: flex;
        gap: 0.7rem;
        margin-top: 1.6rem;
    }

    /*
       Los dos botones miden igual, pero el de cancelar va en línea y el de
       confirmar en macizo: la acción principal se distingue sin que la otra
       quede escondida.
    */
    .modal-pase-botones .boton-confirmar,
    .boton-cancelar {
        flex: 1;
        margin-top: 0;
        padding: 0.7rem 0.5rem;
        border-radius: 10px;
        font-size: clamp(0.95rem, 4.3vw, 1.1rem);
        font-weight: 600;
        cursor: pointer;
    }

    .boton-cancelar {
        border: 1px solid #c2764f;
        background: transparent;
        color: #a05a3c;
        font-family: inherit;
    }

    .boton-cancelar:hover {
        background: rgba(180, 87, 51, 0.08);
    }
</style>

<script>
    import { animarEntrada } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const bloque = document.getElementById("bloque-pase");
        if (bloque) animarEntrada(bloque.children, bloque);

        const btnConfirmar = document.getElementById(
            "btn-confirmar",
        ) as HTMLButtonElement | null;
        const btnWhatsapp = document.getElementById("btn-whatsapp");
        const yaConfirmado = document.getElementById("ya-confirmado");
        const textoConfirmado = document.getElementById("texto-confirmado");
        if (!btnConfirmar || !btnWhatsapp || !yaConfirmado) return;

        const textoOriginal = btnConfirmar.textContent ?? "";
        const textoGracias = textoConfirmado?.textContent ?? "";

        function mostrar(cual: "boton" | "confirmado" | "whatsapp") {
            btnConfirmar!.hidden = cual !== "boton";
            yaConfirmado!.hidden = cual !== "confirmado";
            btnWhatsapp!.hidden = cual !== "whatsapp";
        }

        /*
           Invitacion.astro hace una sola consulta para toda la invitación y
           avisa con este evento. La bandera cubre el caso de que ese script
           haya terminado antes que este y el evento ya haya pasado.
        */
        function acomodar(invitado: any) {
            if (!invitado || !invitado.codigo) {
                // Invitación general: no hay a quién marcar en la lista
                mostrar("whatsapp");
                return;
            }
            mostrar(invitado.confirmado ? "confirmado" : "boton");
        }

        if ((window as any).invitadoActual !== undefined) {
            acomodar((window as any).invitadoActual);
        } else {
            window.addEventListener(
                "invitado-listo",
                (e) => acomodar((e as CustomEvent).detail),
                { once: true },
            );
        }

        // ═══ EL PASO INTERMEDIO ═══
        const modal = document.getElementById("modal-asistencia");
        const btnSi = document.getElementById(
            "btn-confirmar-si",
        ) as HTMLButtonElement | null;

        function abrirModal() {
            if (!modal) return;
            modal.hidden = false;
            document.body.style.overflow = "hidden";
            btnSi?.focus();
        }

        function cerrarModal() {
            if (!modal) return;
            modal.hidden = true;
            document.body.style.overflow = "";
        }

        modal?.querySelectorAll("[data-cerrar-asistencia]").forEach((el) => {
            el.addEventListener("click", cerrarModal);
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && modal && !modal.hidden) cerrarModal();
        });

        // El boton grande ya no confirma: abre el modal
        btnConfirmar.addEventListener("click", abrirModal);

        btnSi?.addEventListener("click", async () => {
            const invitado = (window as any).invitadoActual;
            if (!invitado?.codigo) return;

            btnSi.disabled = true;
            btnSi.textContent = "Confirmando…";
            btnConfirmar.disabled = true;
            try {
                const { supabase, configurado } = await import(
                    "../lib/supabase"
                );
                if (!configurado || !supabase) throw new Error("sin config");

                const { data, error } = await supabase.rpc(
                    "confirmar_asistencia",
                    { codigo_buscado: invitado.codigo },
                );
                if (error || !data || !data.length) throw error;

                invitado.confirmado = true;
                cerrarModal();
                mostrar("confirmado");
            } catch {
                /*
                   Si falla, se devuelve el botón como estaba y se avisa en
                   el mismo texto: el invitado puede reintentar sin quedarse
                   sin saber qué pasó.
                */
                cerrarModal();
                btnSi.disabled = false;
                btnSi.textContent = "Sí, confirmo";
                btnConfirmar.disabled = false;
                btnConfirmar.textContent = textoOriginal;
                if (textoConfirmado) {
                    textoConfirmado.textContent =
                        "No pudimos guardarlo. Probá de nuevo en un rato.";
                    yaConfirmado.hidden = false;
                    window.setTimeout(() => {
                        yaConfirmado.hidden = true;
                        textoConfirmado.textContent = textoGracias;
                    }, 4000);
                }
            }
        });
    });
</script>
