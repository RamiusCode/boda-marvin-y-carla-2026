---
// src/components/Pase.astro
// Tarjeta con los pases reservados para el invitado y, debajo, el pedido de
// confirmación con el botón a WhatsApp.
// Los textos viven en src/i18n; acá solo se elige el idioma.
import { textos, type Idioma } from "../i18n";

// El nombre y la cantidad de pases llegan por prop desde las invitaciones
// personalizadas; acá quedan los valores de muestra.
export interface Props {
    idioma?: Idioma;
    invitado?: string;
    pases?: number;
    /*
       La mesa va aparte del resto: no tiene valor de muestra. Las mesas se
       arman cuando ya se sabe quién confirmó, mucho después de que salen
       las invitaciones, así que lo normal es que al principio no haya
       ninguna. Sin mesa asignada el renglón no se dibuja —un número
       inventado en la tarjeta manda al invitado a la mesa equivocada— y en
       la invitación general, la que se comparte en un grupo, tampoco
       aparece nunca.
    */
    mesa?: number | null;
}
const {
    idioma = "es",
    invitado = "Adriana Candia",
    pases = 2,
    mesa = null,
} = Astro.props;

const t = textos(idioma).pase;
const {
    reservado,
    honor,
    tituloConfirmar,
    aviso,
    textoBoton,
    yaConfirmado,
    modalTitulo,
    modalTexto,
    modalCancelar,
    modalAceptar,
    cuantosAsisten,
    acompananteOpcional,
    modificarRespuesta,
} = t;

// WhatsApp de los novios (código de país + número, sin + ni espacios).
const whatsapp = "59163001482";
const enlace = `https://wa.me/${whatsapp}?text=${encodeURIComponent(t.mensajeWhatsapp)}`;

const palabraPases = pases === 1 ? t.pase : t.pases;

/*
   Vista previa del modal en localhost.

   La bandera se resuelve acá, en el servidor, y viaja al navegador como un
   atributo del HTML. No se pregunta import.meta.env.DEV dentro del <script>
   porque ahí queda sin reemplazar y depende de que Vite haya inyectado el
   objeto de entorno en el navegador: si no lo hizo, la condición da falso y
   la vista previa no aparece.

   Al buildear esto es false, el atributo no se escribe y el botón vuelve a
   ser el de WhatsApp, que es lo que corresponde en la invitación general.
*/
const vistaPrevia = import.meta.env.DEV;
---

<section
    id="pase"
    class="relative w-full overflow-hidden px-7 py-14"
    data-confirmando={t.confirmando}
    data-aceptar={modalAceptar}
    data-error={t.errorConfirmar}
    data-vista-previa={vistaPrevia ? "1" : undefined}
>
    <div id="bloque-pase" class="relative flex flex-col items-center text-center">
        <!-- Tarjeta terracota con los pases -->
        <div class="tarjeta-pase">
            <p class="font-verandah nombre-invitado">{invitado}</p>
            <p class="font-cormorant reservado-pase">{reservado}</p>
            <p class="cantidad-pases">
                {/*
                   El número va en Adelia: Verandah Reverie trae los dígitos
                   bloqueados y dibuja una marca de agua en su lugar.
                */}
                <span class="font-adelia numero-pases">{pases}</span>
                <span class="font-verandah palabra-pases">{palabraPases}</span>
            </p>
            <p class="font-cormorant honor-pase">{honor}</p>

            {/*
               La mesa cierra la tarjeta, separada por un filete: no es del
               mismo orden que lo de arriba. Lo de arriba es el gesto —a
               quién se invita y con cuántos—; esto es el dato práctico que
               el invitado va a venir a buscar el día de la fiesta.

               Lo pinta el script de Invitacion.astro por la clase
               .numero-mesa, igual que el nombre y los pases. El hidden lo
               maneja .bloque-mesa: si el invitado no tiene mesa asignada,
               el renglón no ocupa lugar.
            */}
            <div class="bloque-mesa" hidden={!mesa}>
                <p class="font-cormorant aviso-mesa">{t.mesaAviso}</p>

                {/*
                   El dibujo de la mesa se pinta con máscara y no como <img>:
                   el PNG es trazo negro sobre transparente, y así sale en
                   crema sobre el terracota en vez de una mancha oscura.
                */}
                <span
                    class="icono icono-crema icono-mesa"
                    style="--ic:url('/imagenes/mesa.png')"
                    aria-hidden="true"></span>

                <p class="chapa-mesa">
                    <span class="font-cormorant etiqueta-mesa">{t.mesa}</span>
                    {/*
                       Misma fuente que la palabra y en negrita: resalta por
                       el peso, no por el tamaño ni por cambiar de tipografía.
                    */}
                    <span class="font-cormorant numero-mesa">{mesa}</span>
                </p>
            </div>
        </div>

        <h2 class="font-dancing titulo-confirmar">{tituloConfirmar}</h2>

        <p class="font-cormorant aviso-confirmar">
            {aviso.map((linea) => <span class="block">{linea}</span>)}
        </p>

        <!--
           Dos caminos, y el script decide cuál mostrar:

           · Con link personalizado → el botón confirma en un toque, sin
             escribir nada: la invitación ya sabe quién es.
           · Sin link (la invitación general que se comparte en un grupo)
             → se queda el enlace a WhatsApp, porque ahí no hay a quién
             marcar en la lista.
        -->
        <button
            id="btn-confirmar"
            type="button"
            class="font-cormorant boton-confirmar"
            hidden
        >
            {textoBoton}
        </button>

        <p id="ya-confirmado" class="font-cormorant confirmado-aviso" hidden>
            <span class="tilde" aria-hidden="true">&#10003;</span>
            <span id="texto-confirmado">{yaConfirmado}</span>
        </p>

        <!--
           Quien ya respondió puede corregirse: confirmó por dos y a la
           semana el acompañante no puede ir. Sin esta puerta de vuelta, el
           dato queda viejo y se reserva de más.
        -->
        <button
            id="btn-modificar"
            type="button"
            class="font-cormorant enlace-modificar"
            hidden
        >
            {modificarRespuesta}
        </button>

        <a
            id="btn-whatsapp"
            href={enlace}
            target="_blank"
            rel="noopener noreferrer"
            class="font-cormorant boton-confirmar"
        >
            {textoBoton}
        </a>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- ✅ MODAL · confirmar asistencia                             -->
<!-- ═══════════════════════════════════════════════════════════ -->
<!--
   El paso intermedio existe por dos razones:

   1. Un toque sin querer dejaba al invitado anotado sin vuelta atrás.
   2. Muestra con qué nombre va a quedar registrado. Si alguien reenvió el
      link, esa persona ve que dice "María Valdés" y se da cuenta antes de
      anotarse en el lugar de otro.
-->
<div id="modal-asistencia" class="modal-pase" hidden>
    <div class="modal-pase-velo" data-cerrar-asistencia></div>

    <div
        class="modal-pase-caja"
        role="dialog"
        aria-modal="true"
        aria-labelledby="titulo-modal-asistencia"
    >
        <h3
            id="titulo-modal-asistencia"
            class="font-great-vibes modal-pase-titulo"
        >
            {modalTitulo}
        </h3>

        <p class="font-cormorant modal-pase-texto">{modalTexto}</p>

        <p class="font-verandah nombre-invitado modal-pase-nombre">
            {invitado}
        </p>

        <p class="font-cormorant modal-pase-pases">
            <span class="numero-pases">{pases}</span>
            <span class="palabra-pases">{palabraPases}</span>
        </p>

        <!--
           La pregunta por la cantidad. Queda escondida y vacía hasta que se
           sabe cuántos pases tiene el invitado: ese dato llega de la base
           después de que carga la página, así que las pastillas no se
           pueden escribir acá. A quien tiene un solo pase no se le muestra
           nunca —no hay nada que elegir— y el modal le queda igual que antes.

           Los textos viajan en data- porque este HTML lo lee un script que
           no puede importar el diccionario de idiomas.
        -->
        <div
            id="bloque-asistentes"
            class="bloque-asistentes"
            hidden
            data-titulo-uno={t.tituloAcompanante}
            data-titulo-varios={t.tituloAcompanantes}
            data-placeholder={t.placeholderAcompanante}
        >
            <p class="font-cormorant modal-pase-pregunta">{cuantosAsisten}</p>
            <div
                id="pastillas-asistentes"
                class="pastillas-asistentes"
                role="radiogroup"
                aria-label={cuantosAsisten}
            >
            </div>

            <div id="bloque-acompanantes" hidden>
                <p
                    id="titulo-acompanantes"
                    class="font-cormorant modal-pase-pregunta"
                >
                </p>
                <div id="campos-acompanantes" class="campos-acompanantes"></div>
                <p class="font-cormorant modal-pase-nota">
                    {acompananteOpcional}
                </p>
            </div>
        </div>

        <div class="modal-pase-botones">
            <button
                type="button"
                class="font-cormorant boton-cancelar"
                data-cerrar-asistencia
            >
                {modalCancelar}
            </button>
            <button
                id="btn-confirmar-si"
                type="button"
                class="font-cormorant boton-confirmar"
            >
                {modalAceptar}
            </button>
        </div>
    </div>
</div>

<style>
    .tarjeta-pase {
        position: relative;
        overflow: hidden;
        width: 100%;
        max-width: 330px;
        padding: 2.2rem 1.5rem 2.6rem;
        /* Como el modelo: esquinas apenas redondeadas arriba y el borde de
           abajo curvado, no recto. */
        border-radius: 12px 12px 50% 50% / 12px 12px 26px 26px;
        background: #b45733;
        box-shadow: 0 12px 26px rgba(90, 40, 22, 0.22);
    }

    .nombre-invitado {
        color: #fdf6ee;
        font-size: clamp(1.6rem, 7.2vw, 2rem);
        line-height: 1.3;
    }

    /* Mismo cuerpo que los textos de las otras secciones, para no descuadrar */
    .reservado-pase,
    .honor-pase {
        color: #f6e2d3;
        font-size: clamp(1.15rem, 5.3vw, 1.4rem);
        line-height: 1.4;
    }

    .reservado-pase {
        margin-top: 1.1rem;
    }

    .honor-pase {
        margin-top: 0.9rem;
    }

    .cantidad-pases {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 0.35rem;
        margin-top: 0.5rem;
        color: #fdf6ee;
        font-size: clamp(2rem, 9.2vw, 2.6rem);
        line-height: 1.2;
    }

    /* Adelia es de ojo más chico que Verandah: se compensa acá */
    .numero-pases {
        font-size: 0.94em;
    }

    /*
       El filete de arriba es lo que separa el dato del gesto. Va con el
       margen del lado del filete y no del texto para que, cuando el
       renglón no se dibuja, no quede aire de más al pie de la tarjeta.
    */
    .bloque-mesa {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 1.4rem;
        padding-top: 1.2rem;
        border-top: 1px solid rgba(253, 246, 238, 0.35);
        color: #fdf6ee;
    }

    /* Explícito: el display:flex de arriba le gana al atributo */
    .bloque-mesa[hidden] {
        display: none;
    }

    /*
       Chico y apagado a propósito: es el que presenta al bloque, no el que
       hay que leer. El que importa es el número de abajo.
    */
    .aviso-mesa {
        font-size: clamp(1.15rem, 5.3vw, 1.4rem);
        line-height: 1.3;
        margin-bottom: 0.75rem;
        color: #f6e2d3;
    }

    .icono-mesa {
        width: 2.6rem;
        height: 2.6rem;
        margin-bottom: 0.7rem;
        /* El trazo del dibujo es fino: apagarlo un poco lo deja de
           acompañante y no compitiendo con el número */
        opacity: 0.9;
    }

    /*
       El recuadro: filete crema y un velo apenas más claro que el fondo de
       la tarjeta. Va inline-flex para que se ajuste al texto —encuadrar un
       "MESA 2" en una caja del ancho de la tarjeta lo dejaría flotando.
    */
    .chapa-mesa {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.55rem 1.4rem;
        border: 1px solid rgba(253, 246, 238, 0.7);
        border-radius: 8px;
        background: rgba(253, 246, 238, 0.16);
    }

    .etiqueta-mesa {
        font-size: clamp(1.15rem, 5.3vw, 1.4rem);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.9;
    }

    /*
       El mismo cuerpo que la palabra: lo que lo destaca es la negrita.
       Las lining-nums son necesarias, no de adorno: Cormorant trae cifras
       de estilo antiguo, y con esas el 1 queda enano y el 2 se descuelga
       por debajo de la línea al lado de las versalitas de MESA.
    */
    .numero-mesa {
        font-size: clamp(1.15rem, 5.3vw, 1.4rem);
        font-weight: 700;
        letter-spacing: 0.04em;
        line-height: 1.1;
        font-variant-numeric: lining-nums;
    }

    .titulo-confirmar {
        color: #a4482a;
        font-size: clamp(1.7rem, 7.6vw, 2.1rem);
        line-height: 1.3;
        margin-top: 2.6rem;
    }

    .aviso-confirmar {
        color: #7a3418;
        font-size: clamp(1.15rem, 5.3vw, 1.4rem);
        line-height: 1.5;
        margin-top: 0.9rem;
    }

    .boton-confirmar {
        display: inline-block;
        margin-top: 1.6rem;
        padding: 0.75rem 1.9rem;
        border-radius: 10px;
        background: #b45733;
        color: #fdf1e6;
        font-size: clamp(1.05rem, 4.8vw, 1.25rem);
        font-weight: 600;
        letter-spacing: 0.03em;
        box-shadow: 0 6px 16px rgba(90, 40, 22, 0.22);
        transition: transform 0.3s ease;
    }

    .boton-confirmar:hover {
        transform: scale(1.04);
    }

    /* El botón es un <button>, no un <a>: hay que igualar lo que el
       navegador le pone de fábrica */
    button.boton-confirmar {
        border: none;
        cursor: pointer;
        font-family: inherit;
    }

    button.boton-confirmar:disabled {
        opacity: 0.65;
        cursor: default;
        transform: none;
    }

    .boton-confirmar[hidden],
    .confirmado-aviso[hidden] {
        display: none;
    }

    /* El acuse de recibo, en lugar del botón */
    .confirmado-aviso {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.6rem;
        padding: 0.7rem 1.5rem;
        border: 1px solid #b45733;
        border-radius: 10px;
        color: #7a3418;
        font-size: clamp(1rem, 4.5vw, 1.15rem);
        line-height: 1.4;
    }

    .tilde {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.4rem;
        height: 1.4rem;
        flex: none;
        border-radius: 50%;
        background: #b45733;
        color: #fdf1e6;
        font-size: 0.85rem;
    }

    /* ═══ MODAL DE CONFIRMACIÓN ═══ */
    .modal-pase {
        position: fixed;
        inset: 0;
        z-index: 9998;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.2rem;
    }

    /* Explícito: si no, el display:flex de arriba le gana al atributo */
    .modal-pase[hidden] {
        display: none;
    }

    .modal-pase-velo {
        position: absolute;
        inset: 0;
        background: rgba(74, 30, 16, 0.62);
        backdrop-filter: blur(3px);
    }

    .modal-pase-caja {
        position: relative;
        width: 100%;
        max-width: 21rem;
        padding: 2rem 1.6rem 1.7rem;
        border-radius: 10px;
        background: linear-gradient(160deg, #fdf6ee 0%, #f7e9dc 100%);
        box-shadow: 0 24px 60px rgba(60, 24, 12, 0.45);
        text-align: center;
    }

    .modal-pase-titulo {
        color: #a4482a;
        font-size: clamp(1.8rem, 8.2vw, 2.2rem);
        line-height: 1.2;
    }

    .modal-pase-texto {
        color: #a05a3c;
        font-size: clamp(0.95rem, 4.3vw, 1.05rem);
        margin-top: 0.9rem;
    }

    /* El nombre es lo que el invitado tiene que reconocer: va grande */
    .modal-pase-nombre {
        color: #7a3418;
        font-size: clamp(1.7rem, 8vw, 2.1rem);
        line-height: 1.25;
        margin-top: 0.2rem;
    }

    .modal-pase-pases {
        color: #a05a3c;
        font-size: clamp(0.95rem, 4.3vw, 1.05rem);
        font-variant-numeric: lining-nums;
        margin-top: 0.1rem;
    }

    /* ═══ CUÁNTOS VIENEN ═══ */
    .bloque-asistentes {
        margin-top: 1.3rem;
        padding-top: 1.1rem;
        border-top: 1px solid rgba(180, 87, 51, 0.25);
    }

    .bloque-asistentes[hidden],
    #bloque-acompanantes[hidden] {
        display: none;
    }

    .modal-pase-pregunta {
        color: #7a3418;
        font-size: clamp(1rem, 4.5vw, 1.1rem);
        font-weight: 600;
        margin-bottom: 0.6rem;
    }

    /*
       Las pastillas van en wrap y no en una fila fija: una familia de seis
       no entra en el ancho del modal en un celular chico.
    */
    .pastillas-asistentes {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
    }

    /*
       Fondo macizo y sombra, no un contorno sobre el papel: así se lee como
       algo que sobresale y se puede tocar. Con fondo transparente parecía
       una etiqueta impresa y nadie la apretaba.

       El alto pasa el mínimo cómodo de área táctil: es el control que más
       se toca del modal y se usa con el pulgar.
    */
    /*
       OJO con el :global de acá abajo, no es capricho.

       Astro scopea el CSS agregando [data-astro-cid-…] a cada selector, y
       ese atributo lo pone al renderizar. Estos botones y los campos de
       nombre se crean con createElement en el navegador, así que nunca lo
       reciben: sin :global las reglas no les aplican nunca y quedan como
       números pelados sobre el papel.

       Van colgados de .pastillas-asistentes y .campos-acompanantes, que sí
       están en la plantilla y sí llevan el atributo. Así el :global queda
       encerrado adentro de este componente y no se escapa al resto.
    */
    .pastillas-asistentes :global(.opcion-asistentes) {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2.9rem;
        padding: 0.5rem 0.95rem;
        border: 1px solid #c2764f;
        border-radius: 999px;
        background: #fffaf4;
        color: #a05a3c;
        font-family: inherit;
        font-size: clamp(1.05rem, 4.8vw, 1.2rem);
        font-weight: 600;
        font-variant-numeric: lining-nums;
        cursor: pointer;
        box-shadow: 0 2px 5px rgba(90, 40, 22, 0.14);
        transition:
            background 0.15s,
            color 0.15s,
            border-color 0.15s,
            transform 0.15s;
    }

    .pastillas-asistentes :global(.opcion-asistentes:hover) {
        background: #fdf1e6;
        transform: translateY(-1px);
    }

    /* Se hunde al tocarla: el gesto confirma que respondió */
    .pastillas-asistentes :global(.opcion-asistentes:active) {
        transform: translateY(1px);
        box-shadow: 0 1px 3px rgba(90, 40, 22, 0.18);
    }

    /* El circulito, igual que un radio de formulario */
    .pastillas-asistentes :global(.marca-radio) {
        position: relative;
        width: 1.05rem;
        height: 1.05rem;
        flex: none;
        border: 2px solid #c2764f;
        border-radius: 50%;
        background: #fff;
    }

    .pastillas-asistentes :global(.marca-radio)::after {
        content: "";
        position: absolute;
        inset: 2.5px;
        border-radius: 50%;
        background: transparent;
    }

    /*
       La elegida se rellena en macizo. El color por sí solo no alcanza para
       quien no lo distingue, así que además se le llena el circulito: la
       forma cambia, no solo el tono.
    */
    .pastillas-asistentes :global(.opcion-asistentes[aria-checked="true"]) {
        background: #b45733;
        border-color: #8d3f22;
        color: #fdf1e6;
    }

    .pastillas-asistentes :global(.opcion-asistentes[aria-checked="true"] .marca-radio) {
        border-color: #fdf1e6;
        background: transparent;
    }

    .pastillas-asistentes :global(.opcion-asistentes[aria-checked="true"] .marca-radio)::after {
        background: #fdf1e6;
    }

    .campos-acompanantes {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .campos-acompanantes :global(.campo-acompanante) {
        width: 100%;
        padding: 0.6rem 0.85rem;
        border: 1px solid #c2764f;
        border-radius: 10px;
        background: #fffaf4;
        color: #7a3418;
        font-family: inherit;
        font-size: clamp(0.95rem, 4.3vw, 1.05rem);
        outline: none;
        transition:
            border-color 0.15s,
            box-shadow 0.15s;
    }

    .campos-acompanantes :global(.campo-acompanante:focus) {
        border-color: #b45733;
        box-shadow: 0 0 0 3px rgba(180, 87, 51, 0.15);
    }

    .campos-acompanantes :global(.campo-acompanante)::placeholder {
        color: #c19a80;
    }

    /* El aviso de que se puede dejar vacío: chico, es una aclaración */
    .modal-pase-nota {
        color: #a05a3c;
        font-size: clamp(0.85rem, 3.9vw, 0.95rem);
        margin-top: 0.5rem;
        opacity: 0.9;
    }

    /*
       "Modificar mi respuesta" es un botón pero se ve como enlace: la
       acción principal de esta pantalla ya fue hecha, esto es la salida de
       emergencia y no tiene que competir con nada.
    */
    .enlace-modificar {
        display: inline-block;
        margin-top: 0.8rem;
        padding: 0.3rem 0.5rem;
        border: none;
        background: none;
        color: #a4482a;
        font-family: inherit;
        font-size: clamp(0.95rem, 4.3vw, 1.05rem);
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
    }

    .enlace-modificar[hidden] {
        display: none;
    }

    .modal-pase-botones {
        display: flex;
        gap: 0.7rem;
        margin-top: 1.6rem;
    }

    /*
       Los dos botones miden igual, pero el de cancelar va en línea y el de
       confirmar en macizo: la acción principal se distingue sin que la otra
       quede escondida.
    */
    .modal-pase-botones .boton-confirmar,
    .boton-cancelar {
        flex: 1;
        margin-top: 0;
        padding: 0.7rem 0.5rem;
        border-radius: 10px;
        font-size: clamp(0.95rem, 4.3vw, 1.1rem);
        font-weight: 600;
        cursor: pointer;
    }

    .boton-cancelar {
        border: 1px solid #c2764f;
        background: transparent;
        color: #a05a3c;
        font-family: inherit;
    }

    .boton-cancelar:hover {
        background: rgba(180, 87, 51, 0.08);
    }
</style>

<script>
    import { animarEntrada } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const bloque = document.getElementById("bloque-pase");
        if (bloque) animarEntrada(bloque.children, bloque);

        const btnConfirmar = document.getElementById(
            "btn-confirmar",
        ) as HTMLButtonElement | null;
        const btnWhatsapp = document.getElementById("btn-whatsapp");
        const yaConfirmado = document.getElementById("ya-confirmado");
        const textoConfirmado = document.getElementById("texto-confirmado");
        if (!btnConfirmar || !btnWhatsapp || !yaConfirmado) return;

        const textoOriginal = btnConfirmar.textContent ?? "";
        const textoGracias = textoConfirmado?.textContent ?? "";

        const btnModificar = document.getElementById(
            "btn-modificar",
        ) as HTMLButtonElement | null;

        function mostrar(cual: "boton" | "confirmado" | "whatsapp") {
            btnConfirmar!.hidden = cual !== "boton";
            yaConfirmado!.hidden = cual !== "confirmado";
            btnWhatsapp!.hidden = cual !== "whatsapp";
            // La puerta de vuelta solo tiene sentido si ya respondió
            if (btnModificar) btnModificar.hidden = cual !== "confirmado";
        }

        /*
           Invitacion.astro hace una sola consulta para toda la invitación y
           avisa con este evento. La bandera cubre el caso de que ese script
           haya terminado antes que este y el evento ya haya pasado.
        */
        // De acá saca el modal cuántos pases mostrar
        let datosModal: any = null;

        function acomodar(invitado: any) {
            if (!invitado || !invitado.codigo) {
                /*
                   En localhost se muestra igual el botón, con una invitación
                   de muestra de 3 pases, para poder abrir el modal y mirar
                   el diseño sin cargar un invitado ni armar un link.

                   Confirmar no hace nada: el que guarda es el handler de
                   abajo y arranca con un "si no hay código, no toca la base".
                   La bandera la pone el servidor en data-vista-previa: al
                   buildear no se escribe, así que esto se saca solo y en lo
                   que se sube vuelve a aparecer el botón de WhatsApp, que es
                   lo que corresponde en la invitación general.
                */
                const previa =
                    document.getElementById("pase")?.dataset.vistaPrevia;
                if (previa === "1") {
                    datosModal = { pases: 3, asisten: null, acompanantes: [] };
                    mostrar("boton");
                    return;
                }
                // Invitación general: no hay a quién marcar en la lista
                mostrar("whatsapp");
                return;
            }
            datosModal = invitado;
            mostrar(invitado.confirmado ? "confirmado" : "boton");
        }

        if ((window as any).invitadoActual !== undefined) {
            acomodar((window as any).invitadoActual);
        } else {
            window.addEventListener(
                "invitado-listo",
                (e) => acomodar((e as CustomEvent).detail),
                { once: true },
            );
        }

        // ═══ EL PASO INTERMEDIO ═══
        /*
           Los textos que se escriben en caliente vienen en los data- de la
           sección: acá adentro no se puede importar el diccionario, así que
           el idioma viaja por el HTML.
        */
        const seccion = document.getElementById("pase");
        const dicc = {
            confirmando: seccion?.dataset.confirmando ?? "Confirmando…",
            aceptar: seccion?.dataset.aceptar ?? "Sí, confirmo",
            error: seccion?.dataset.error ?? "No pudimos guardarlo.",
        };

        const modal = document.getElementById("modal-asistencia");
        const btnSi = document.getElementById(
            "btn-confirmar-si",
        ) as HTMLButtonElement | null;

        // ═══ CUÁNTOS VIENEN, Y CON QUIÉN ═══
        const bloqueAsistentes = document.getElementById("bloque-asistentes");
        const pastillas = document.getElementById("pastillas-asistentes");
        const bloqueAcomp = document.getElementById("bloque-acompanantes");
        const tituloAcomp = document.getElementById("titulo-acompanantes");
        const camposAcomp = document.getElementById("campos-acompanantes");

        // Cuántos dijo que vienen. Arranca en null: hasta que no se arma el
        // modal no se sabe ni cuántos pases tiene.
        let elegidos: number | null = null;

        /*
           Los nombres se guardan acá y no solo en los inputs: si el invitado
           escribe dos nombres, baja a 1 y vuelve a 2, los campos se rehacen
           y lo tipeado se perdería. Con este respaldo vuelve como estaba.
        */
        let nombresEscritos: string[] = [];

        function leerNombres() {
            if (!camposAcomp) return;
            const campos = camposAcomp.querySelectorAll("input");
            campos.forEach((campo, i) => {
                nombresEscritos[i] = campo.value;
            });
        }

        function pintarCampos() {
            if (!bloqueAcomp || !tituloAcomp || !camposAcomp || !elegidos)
                return;

            // El invitado principal ya está por nombre: los campos son para
            // los que lo acompañan, uno menos que el total
            const cuantos = elegidos - 1;
            bloqueAcomp.hidden = cuantos < 1;
            if (cuantos < 1) return;

            const datos = bloqueAsistentes?.dataset ?? {};
            tituloAcomp.textContent =
                cuantos === 1
                    ? (datos.tituloUno ?? "")
                    : (datos.tituloVarios ?? "");

            camposAcomp.textContent = "";
            for (let i = 0; i < cuantos; i++) {
                const campo = document.createElement("input");
                campo.type = "text";
                campo.className = "campo-acompanante";
                campo.maxLength = 80;
                campo.placeholder = datos.placeholder ?? "";
                campo.value = nombresEscritos[i] ?? "";
                campo.addEventListener("input", leerNombres);
                camposAcomp.append(campo);
            }
        }

        /*
           Las pastillas se arman en caliente porque dependen de cuántos
           pases tiene el invitado, y ese dato llega de la base después de
           que carga la página.
        */
        function armarAsistentes(invitado: any) {
            if (!bloqueAsistentes || !pastillas) return;

            const pases = Number(invitado?.pases) || 1;

            // Con un solo pase no hay nada que preguntar
            if (pases < 2) {
                bloqueAsistentes.hidden = true;
                elegidos = pases;
                return;
            }

            // Si ya había respondido, se vuelve a abrir con su respuesta
            // puesta: está corrigiendo, no empezando de cero
            elegidos = Math.min(Number(invitado?.asisten) || pases, pases);
            nombresEscritos = Array.isArray(invitado?.acompanantes)
                ? [...invitado.acompanantes]
                : [];

            pastillas.textContent = "";
            for (let n = 1; n <= pases; n++) {
                const boton = document.createElement("button");
                boton.type = "button";
                boton.className = "opcion-asistentes";

                /*
                   El circulito de radio va adentro del botón. Es lo que
                   avisa que hay que elegir: un número suelto en un recuadro
                   se lee como una etiqueta y la gente no lo toca.
                */
                const marca = document.createElement("span");
                marca.className = "marca-radio";
                marca.setAttribute("aria-hidden", "true");

                const cifra = document.createElement("span");
                cifra.className = "numero-opcion";
                cifra.textContent = String(n);

                boton.append(marca, cifra);

                /*
                   role/aria-checked y no una clase: para un lector de
                   pantalla esto es un grupo de opciones excluyentes, igual
                   que un radio de toda la vida.
                */
                boton.setAttribute("role", "radio");
                boton.setAttribute("aria-checked", String(n === elegidos));
                boton.addEventListener("click", () => {
                    leerNombres();
                    elegidos = n;
                    pastillas
                        .querySelectorAll("button")
                        .forEach((b, i) =>
                            b.setAttribute("aria-checked", String(i + 1 === n)),
                        );
                    pintarCampos();
                });
                pastillas.append(boton);
            }

            bloqueAsistentes.hidden = false;
            pintarCampos();
        }

        function abrirModal() {
            if (!modal) return;
            armarAsistentes(datosModal);
            modal.hidden = false;
            document.body.style.overflow = "hidden";
            btnSi?.focus();
        }

        function cerrarModal() {
            if (!modal) return;
            modal.hidden = true;
            document.body.style.overflow = "";
        }

        modal?.querySelectorAll("[data-cerrar-asistencia]").forEach((el) => {
            el.addEventListener("click", cerrarModal);
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && modal && !modal.hidden) cerrarModal();
        });

        // El boton grande ya no confirma: abre el modal
        btnConfirmar.addEventListener("click", abrirModal);

        // Y el mismo modal sirve para corregir lo ya respondido
        btnModificar?.addEventListener("click", abrirModal);

        btnSi?.addEventListener("click", async () => {
            const invitado = (window as any).invitadoActual;
            if (!invitado?.codigo) return;

            btnSi.disabled = true;
            btnSi.textContent = dicc.confirmando;
            btnConfirmar.disabled = true;
            try {
                const { supabase, configurado } = await import(
                    "../lib/supabase"
                );
                if (!configurado || !supabase) throw new Error("sin config");

                /*
                   Se manda lo que quedó tipeado en ese momento, no lo que
                   se guardó en el último evento de input: alguien puede
                   tocar "Sí, confirmo" con el teclado todavía abierto.
                */
                leerNombres();
                const cuantos = elegidos ?? (Number(invitado.pases) || 1);

                const { data, error } = await supabase.rpc(
                    "confirmar_asistencia",
                    {
                        codigo_buscado: invitado.codigo,
                        asisten_nuevo: cuantos,
                        acompanantes_nuevos: nombresEscritos
                            .slice(0, Math.max(cuantos - 1, 0))
                            .map((n) => (n ?? "").trim())
                            .filter(Boolean),
                    },
                );
                if (error || !data || !data.length) throw error;

                /*
                   Se copia lo que devolvió la base y no lo que se mandó: es
                   ella la que recorta y limpia, así que si al invitado le
                   quedó otra cosa guardada, el modal se reabre con lo que
                   está realmente anotado.
                */
                invitado.confirmado = true;
                invitado.asisten = data[0].asisten;
                invitado.acompanantes = data[0].acompanantes ?? [];
                cerrarModal();
                mostrar("confirmado");
            } catch {
                /*
                   Si falla, se devuelve el botón como estaba y se avisa en
                   el mismo texto: el invitado puede reintentar sin quedarse
                   sin saber qué pasó.
                */
                cerrarModal();
                btnSi.disabled = false;
                btnSi.textContent = dicc.aceptar;
                btnConfirmar.disabled = false;
                btnConfirmar.textContent = textoOriginal;
                if (textoConfirmado) {
                    textoConfirmado.textContent = dicc.error;
                    yaConfirmado.hidden = false;
                    window.setTimeout(() => {
                        yaConfirmado.hidden = true;
                        textoConfirmado.textContent = textoGracias;
                    }, 4000);
                }
            }
        });
    });
</script>
