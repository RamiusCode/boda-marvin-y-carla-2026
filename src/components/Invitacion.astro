---
// src/components/Invitacion.astro
// El cuerpo completo de la invitación, en un solo lugar.
import Portada from "./Portada.astro";
import NombresFlores from "./NombresFlores.astro";
import Dedicatoria from "./Dedicatoria.astro";
import Foto1 from "./Foto1.astro";
import Dedicatoria2 from "./Dedicatoria2.astro";
import Versiculo from "./Versiculo.astro";
import NombresPadres from "./NombresPadres.astro";
import NombresPadrinos from "./NombresPadrinos.astro";
import Dedicatoria3 from "./Dedicatoria3.astro";
import Fecha from "./Fecha.astro";
import Mensaje from "./Mensaje.astro";
import CeremoniaReligiosa from "./CeremoniaReligiosa.astro";
import RecepcionSocial from "./RecepcionSocial.astro";
import Cronograma from "./Cronograma.astro";
import CodigoVestimenta from "./CodigoVestimenta.astro";
import Pase from "./Pase.astro";
import SugerenciaRegalo from "./SugerenciaRegalo.astro";
import Restriccion from "./Restriccion.astro";
import Puntualidad from "./Puntualidad.astro";
import Historia from "./Historia.astro";
import Confirmar from "./Confirmar.astro";
import BuenosDeseos from "./BuenosDeseos.astro";
import NuestraHistoria from "./NuestraHistoria.astro";
import Despedida from "./Despedida.astro";
import BotonMusica from "./BotonMusica.astro";

// El idioma llega desde la página: index.astro manda "es" y en/index.astro
// manda "en". Cada sección traducida lo recibe y saca sus textos de
// src/i18n; las que todavía no se tradujeron lo ignoran.
import { textos, type Idioma } from "../i18n";

export interface Props {
    idioma?: Idioma;
}
const { idioma = "es" } = Astro.props;

const t = textos(idioma);
---

<!-- PORTADA (cubre todo hasta que se toca el botón de ingreso) -->
<Portada idioma={idioma} />

<!-- CONTENIDO DE LA INVITACIÓN -->
<div
    id="contenido-principal"
    data-pase={t.pase.pase}
    data-pases={t.pase.pases}
>
    <NombresFlores />
    <Dedicatoria idioma={idioma} />
    <Foto1 idioma={idioma} />
    <Dedicatoria2 idioma={idioma} />
    <Versiculo idioma={idioma} />
      <Fecha idioma={idioma} />
    <Mensaje idioma={idioma} />
    <NombresPadres idioma={idioma} />

    <NombresPadrinos idioma={idioma} />
    <Dedicatoria3 idioma={idioma} />

    <CeremoniaReligiosa idioma={idioma} />
    <RecepcionSocial idioma={idioma} />
      <CodigoVestimenta idioma={idioma} />
        <Cronograma idioma={idioma} />
    <Puntualidad idioma={idioma} />
     <SugerenciaRegalo idioma={idioma} />
    <Pase idioma={idioma} />
   
    <!-- <Restriccion /> -->
  
  
    <BuenosDeseos idioma={idioma} />
    <NuestraHistoria idioma={idioma} />

    <!-- <Historia /> -->
    <!-- <Confirmar /> -->
    <Despedida idioma={idioma} />
</div>

<!-- Control de música flotante -->
<BotonMusica />

<script>
    /*
       ═══════════════════════════════════════════════════════════
       EL NOMBRE DEL INVITADO
       ═══════════════════════════════════════════════════════════
       El link personalizado trae un código: mi-invitacion.com/k7m2p
       Con ese código se busca en la base quién es y cuántos pases tiene, y
       se completan los dos lugares donde aparece: la Portada y el Pase.

       El nombre NO viaja en el link, solo el código. Por eso, si el
       cliente corrige un nombre mal escrito, el link ya enviado muestra el
       nombre corregido sin tener que reenviar nada.

       Este script vive acá y no en el Layout a propósito: así no corre en
       /admin, donde el primer tramo de la ruta ("admin") se leería como si
       fuera el código de un invitado.
    */
    const nombres =
        document.querySelectorAll<HTMLElement>(".nombre-invitado");
    const numeros = document.querySelectorAll<HTMLElement>(".numero-pases");
    const palabras = document.querySelectorAll<HTMLElement>(".palabra-pases");

    /*
       La mesa no se tapa como el nombre: no tiene valor de muestra que
       ocultar. Arranca escondida y solo se muestra si el invitado tiene
       una asignada.
    */
    const mesas = document.querySelectorAll<HTMLElement>(".numero-mesa");
    const bloquesMesa = document.querySelectorAll<HTMLElement>(".bloque-mesa");

    /*
       Singular y plural salen del idioma de la página, no escritos acá:
       en la invitación en inglés un invitado con un solo pase tiene que
       leer "seat", no "pase".
    */
    const contenido = document.getElementById("contenido-principal");
    const palabraPase = contenido?.dataset.pase ?? "pase";
    const palabraPases = contenido?.dataset.pases ?? "pases";

    function pintar(
        nombre: string | null,
        pases: number | null,
        mesa: number | null,
    ) {
        if (nombre) nombres.forEach((el) => (el.textContent = nombre));

        if (Number.isInteger(pases) && (pases as number) > 0) {
            numeros.forEach((el) => (el.textContent = String(pases)));
            palabras.forEach((el) => {
                el.textContent = pases === 1 ? palabraPase : palabraPases;
            });
        }

        /*
           Sin mesa asignada el renglón se queda escondido. El else no es de
           adorno: si el cliente le saca la mesa a un invitado que ya la
           tenía, la tarjeta tiene que volver a quedar sin el dato viejo.
        */
        const hayMesa = Number.isInteger(mesa) && (mesa as number) > 0;
        if (hayMesa) mesas.forEach((el) => (el.textContent = String(mesa)));
        bloquesMesa.forEach((el) => (el.hidden = !hayMesa));
    }

    /*
       El dato del invitado lo necesitan también el Pase —para saber si
       mostrar el botón de confirmar o el "ya confirmaste"— y los Buenos
       Deseos, para firmar el mensaje con su nombre.

       Se avisa con un evento en vez de que cada sección haga su propia
       consulta: una sola ida a la base para toda la invitación. La bandera
       es para las secciones cuyo script corra después de este y no lleguen
       a escuchar el evento.
    */
    function avisar(datos: unknown) {
        (window as any).invitadoActual = datos;
        window.dispatchEvent(
            new CustomEvent("invitado-listo", { detail: datos }),
        );
    }

    import("../lib/supabase")
        .then(({ supabase, configurado, codigoDeLaUrl }) => {
            const codigo = codigoDeLaUrl();

            // Sin código es la invitación general, la que se comparte en un
            // grupo: se queda con los valores de muestra del componente.
            if (!codigo || !configurado || !supabase) {
                avisar(null);
                return null;
            }

            /*
               Los nombres de muestra se ocultan mientras se resuelve la
               búsqueda: si no, el invitado alcanza a leer el nombre de otra
               persona antes del reemplazo. Se guardan para poder
               devolverlos si la consulta falla.
            */
            const respaldo = Array.from(nombres, (el) => el.textContent ?? "");
            nombres.forEach((el) => (el.style.visibility = "hidden"));

            return supabase
                .rpc("buscar_invitado", { codigo_buscado: codigo })
                .then(({ data, error }) => {
                    if (!error && data && data.length) {
                        pintar(data[0].nombre, data[0].pases, data[0].mesa);
                        avisar({ codigo, ...data[0] });
                    } else {
                        // Código inexistente: se devuelven los de muestra
                        nombres.forEach((el, i) => {
                            el.textContent = respaldo[i];
                        });
                        avisar(null);
                    }
                    nombres.forEach((el) => (el.style.visibility = ""));
                });
        })
        .catch(() => {
            /*
               Sin internet o base dormida. La invitación tiene que verse
               igual: se destapan los nombres de muestra y el invitado ni se
               entera de que algo falló.
            */
            nombres.forEach((el) => (el.style.visibility = ""));
            avisar(null);
        });
</script>
