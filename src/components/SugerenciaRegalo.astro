---
// src/components/SugerenciaRegalo.astro
// Sugerencia de regalo: el QR para transferencia y, debajo, la nota de que
// la invitación es solo para adultos.
// Los textos viven en src/i18n; acá solo se elige el idioma.
import { textos, type Idioma } from "../i18n";

export interface Props {
    idioma?: Idioma;
}
const { idioma = "es" } = Astro.props;

const t = textos(idioma).regalo;
const { titulo, texto, rotuloQr, altQr, altFoto } = t;

/*
   En inglés la caja no lleva el QR sino PayPal.

   No es una preferencia de diseño: el QR es de un banco boliviano y a
   quien paga desde el exterior no le sirve. La versión en inglés la lee
   justamente esa gente.
*/
const esIngles = idioma === "en";

// ── DATOS EDITABLES ───────────────────────────────────────────
// El número de cuenta y el titular no se traducen.
// Imagen del QR: dejala en public/imagenes/. Si se deja vacío, la caja
// aparece igual pero con el recuadro punteado en lugar del código.
const qr = "/imagenes/qr.png";
const banco = "Banco Sol";
const cuenta = "Cuenta N° 3441510-000-001";
const titular = "Carla Andrea Salinas Zegarra";

// ── PAYPAL · solo la versión en inglés ────────────────────────
/*
   Va vacío por decisión del cliente: pidió que la caja muestre solo el
   nombre de la cuenta, sin link ni botón.

   Queda anotado porque tiene una consecuencia: PayPal no deja buscar
   gente por nombre y apellido, así que con "Marvin Llanos" el invitado
   no tiene por dónde mandar el dinero. La caja informa a quién iría el
   regalo, no habilita a hacerlo.

   Si más adelante cambia de idea, alcanza con pegar el link acá y el
   botón aparece solo; el resto ya está hecho:
   const paypal = "https://paypal.me/MarvinLlanos";
*/
const paypal = "";
const paypalNombre = "Marvin Llanos";
const paypalLogo = "/imagenes/paypal.png";

// El archivo está guardado con el nombre trastocado ("perrtio", no
// "perrito"): se referencia tal cual para no romper el enlace.
const foto = "/imagenes/perrtio3.png";
// ──────────────────────────────────────────────────────────────
---

<section id="regalo" class="relative w-full overflow-hidden px-7 py-16">
    <!--
       Filete impreso. Va antes que los ramos en el markup a propósito: sin
       z-index propio, el orden del documento decide, y así las flores le
       pasan por encima como en la papelería de verdad.
    -->
    <span class="filete" aria-hidden="true"></span>

    <!-- Ramos en diagonal, como en las demás secciones -->
    <img
        src="/imagenes/flores2.png"
        alt=""
        aria-hidden="true"
        class="ramo ramo-si"
    />
    <img
        src="/imagenes/flores2.png"
        alt=""
        aria-hidden="true"
        class="ramo ramo-id"
    />

    <div
        id="bloque-regalo"
        class="relative flex flex-col items-center text-center"
    >
        <!-- Cajita de regalo, dibujada a línea como en el modelo -->
        <svg class="icono-regalo" viewBox="0 0 48 46" aria-hidden="true">
            <g
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M4 16h40v8H4z"></path>
                <path d="M7 24h34v20H7z"></path>
                <path d="M24 16v28"></path>
                <path
                    d="M24 16c-4 0-11 .4-13.6-2.2a4.6 4.6 0 0 1 0-6.6C13 4.6 17.7 6.7 20 9.2c1.9 2 3 4.6 4 6.8z"
                ></path>
                <path
                    d="M24 16c4 0 11 .4 13.6-2.2a4.6 4.6 0 0 0 0-6.6C35 4.6 30.3 6.7 28 9.2c-1.9 2-3 4.6-4 6.8z"
                ></path>
            </g>
        </svg>

        <h2 class="font-great-vibes titulo-regalo">{titulo}</h2>

        <p class="font-cormorant texto-regalo">
            {texto.map((linea) => <span class="block">{linea}</span>)}
        </p>

        <!-- El PNG ya trae su marco de papel rasgado y sus flores -->
        <img
            src={foto}
            alt={altFoto}
            width="799"
            height="579"
            class="foto-regalo"
        />

        <!--
           La misma caja para los dos idiomas: mismo marco, mismos filetes,
           misma tipografía. Lo único que cambia es qué medio de pago va
           adentro, que es lo que de verdad se diferencia.
        -->
        <div class="caja-qr">
            {
                esIngles ? (
                    <>
                        <p class="font-cormorant rotulo-qr">{t.rotuloPaypal}</p>
                        <span class="linea-qr" aria-hidden="true" />

                        <img
                            src={paypalLogo}
                            alt={t.altPaypal}
                            width="593"
                            height="585"
                            class="logo-paypal"
                        />

                        <span
                            class="linea-qr linea-cuenta"
                            aria-hidden="true"
                        />

                        <p class="font-cormorant banco-regalo">
                            {t.etiquetaCuentaPaypal}
                        </p>
                        <p class="font-cormorant titular-regalo nombre-paypal">
                            {paypalNombre}
                        </p>

                        {/* Sin link no se dibuja el botón: ver el comentario
                            de arriba, en los datos editables. */}
                        {paypal && (
                            <a
                                href={paypal}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-cormorant boton-paypal"
                            >
                                {t.botonPaypal}
                            </a>
                        )}

                        <p class="font-cormorant gracias-paypal">
                            {t.graciasPaypal}
                        </p>
                    </>
                ) : (
                    <>
                        <p class="font-cormorant rotulo-qr">{rotuloQr}</p>
                        <span class="linea-qr" aria-hidden="true" />

                        {qr ? (
                            <img src={qr} alt={altQr} class="imagen-qr" />
                        ) : (
                            <span class="hueco-qr" aria-hidden="true" />
                        )}

                        <span
                            class="linea-qr linea-cuenta"
                            aria-hidden="true"
                        />

                        <p class="font-cormorant banco-regalo">{banco}</p>
                        <p class="font-cormorant cuenta-regalo">{cuenta}</p>
                        <p class="font-cormorant titular-regalo">{titular}</p>
                    </>
                )
            }
        </div>

    </div>
</section>

<style>
    /* Filete fino, como el impreso de la invitación */
    .filete {
        position: absolute;
        inset: 14px;
        border: 1px solid rgba(164, 72, 42, 0.3);
        pointer-events: none;
    }

    /* ── Ramos de las esquinas ── */
    .ramo {
        position: absolute;
        width: 30%;
        height: auto;
        z-index: 0;
        pointer-events: none;
        user-select: none;
    }

    .ramo-si {
        top: 0;
        left: -13%;
        transform: scaleY(-1) rotate(4deg);
    }

    .ramo-id {
        bottom: 0;
        right: -13%;
        transform: scaleX(-1) rotate(4deg);
    }

    .icono-regalo {
        width: 58px;
        height: 56px;
        color: #a4482a;
    }

    /* Great Vibes tiene el ojo más chico que Dancing Script: sube de 7.6vw
       a 9.6vw para quedar del mismo cuerpo que los otros títulos */
    .titulo-regalo {
        color: #a4482a;
        font-size: clamp(2.1rem, 9.6vw, 2.7rem);
        line-height: 1.25;
        margin-top: 0.8rem;
    }

    /* El PNG ya trae marco y flores: va sin envoltorio */
    .foto-regalo {
        display: block;
        width: 100%;
        max-width: 21rem;
        height: auto;
        margin: 1.6rem auto 0;
    }

    .texto-regalo {
        color: #7a3418;
        font-size: clamp(1.05rem, 4.7vw, 1.22rem);
        line-height: 1.6;
        margin-top: 1rem;
    }

    .caja-qr {
        width: 100%;
        max-width: 330px;
        margin-top: 1.8rem;
        padding: 1.2rem 1.1rem 1.4rem;
        /* Recuadro cuadrado, igual que la nota del código de vestimenta */
        border: 1px solid #c2764f;
    }

    .rotulo-qr {
        color: #a05a3c;
        font-size: clamp(1rem, 4.5vw, 1.18rem);
        letter-spacing: 0.14em;
        /* text-indent compensa el hueco que el tracking deja después de la
           última letra; sin esto el renglón se ve corrido a la izquierda */
        text-indent: 0.14em;
        line-height: 1.3;
    }

    .linea-qr {
        display: block;
        height: 1px;
        margin: 0.8rem 0.4rem 1.1rem;
        background: #d9a883;
    }

    .imagen-qr {
        display: block;
        width: 72%;
        max-width: 210px;
        margin: 0 auto;
        border-radius: 10px;
        background: #ffffff;
    }

    /* La segunda línea separa el QR de los datos de la cuenta */
    .linea-cuenta {
        margin: 1.2rem 0.4rem 1rem;
    }

    /* El nombre del banco, en dorado macizo y versalitas */
    .banco-regalo {
        color: #b0862b;
        font-size: clamp(1.12rem, 5vw, 1.3rem);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        /* text-indent compensa el hueco que el tracking deja después de la
           última letra; sin esto el renglón se ve corrido a la izquierda */
        text-indent: 0.16em;
        line-height: 1.3;
        margin-bottom: 0.3rem;
    }

    .cuenta-regalo {
        color: #a05a3c;
        font-size: clamp(1.02rem, 4.6vw, 1.18rem);
        line-height: 1.4;
        /* Cifras de caja alta: las de estilo antiguo bailan de altura */
        font-variant-numeric: lining-nums;
    }

    .titular-regalo {
        color: #7a3418;
        font-size: clamp(1.08rem, 4.9vw, 1.25rem);
        font-weight: 600;
        line-height: 1.4;
        margin-top: 0.25rem;
    }

    /* ═══ PAYPAL · solo la versión en inglés ═══ */

    /*
       Más chico que el QR: un QR hay que poder escanearlo desde otro
       celular y por eso ocupa el 72% de la caja. El logo solo dice de qué
       medio de pago se trata, así que a ese tamaño gritaría.
    */
    .logo-paypal {
        display: block;
        width: 40%;
        max-width: 110px;
        height: auto;
        margin: 0 auto;
    }

    /* El nombre es lo que el invitado compara contra lo que le muestra
       PayPal antes de pagar: va más grande que la etiqueta de arriba */
    .nombre-paypal {
        font-size: clamp(1.2rem, 5.4vw, 1.4rem);
    }

    /*
       El botón lleva al link de PayPal. Macizo y no en línea: es la única
       acción de toda la sección, y el invitado la busca con el pulgar.
    */
    .boton-paypal {
        display: inline-block;
        margin-top: 1.1rem;
        padding: 0.7rem 1.8rem;
        border-radius: 10px;
        background: #b45733;
        color: #fdf1e6;
        font-size: clamp(1.02rem, 4.6vw, 1.18rem);
        font-weight: 600;
        letter-spacing: 0.02em;
        box-shadow: 0 6px 16px rgba(90, 40, 22, 0.22);
        transition: transform 0.3s ease;
    }

    .boton-paypal:hover {
        transform: scale(1.04);
    }

    /* El agradecimiento cierra la caja: chico y en versalitas, es un gesto
       y no un dato que haya que leer */
    .gracias-paypal {
        color: #a4482a;
        font-size: clamp(0.82rem, 3.7vw, 0.92rem);
        letter-spacing: 0.08em;
        line-height: 1.4;
        margin-top: 1rem;
    }

    /* Marca el lugar del QR mientras no esté cargada la imagen */
    .hueco-qr {
        display: block;
        width: 72%;
        max-width: 210px;
        aspect-ratio: 1 / 1;
        margin: 0 auto;
        border: 1px dashed #d9a883;
        border-radius: 10px;
    }

</style>

<script>
    import { animarEntrada } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const bloque = document.getElementById("bloque-regalo");
        if (bloque) animarEntrada(bloque.children, bloque);
    });
</script>
