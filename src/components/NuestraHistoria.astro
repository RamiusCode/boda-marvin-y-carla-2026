---
// src/components/NuestraHistoria.astro
// La historia en corto: el título con su corazón, dos párrafos y el
// corazón de cierre. Va sobre el papel de acuarela, como las demás
// secciones claras.
//
// No confundir con Historia.astro, que es la versión larga: banda de color
// y modal con cinco párrafos.

// Los textos viven en src/i18n; acá solo se elige el idioma.
import { textos, type Idioma } from "../i18n";

export interface Props {
    idioma?: Idioma;
}
const { idioma = "es" } = Astro.props;

const { titulo, primero, segundoInicio, segundoResalte } =
    textos(idioma).historia;
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 💞 NUESTRA HISTORIA                                         -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section id="nuestra-historia" class="relative w-full overflow-hidden px-8 py-16">
    <!--
       Filete impreso. Va antes que los ramos en el markup a propósito: sin
       z-index propio, el orden del documento decide, y así las flores le
       pasan por encima como en la papelería de verdad.
    -->
    <span class="filete" aria-hidden="true"></span>

    <!-- Ramos en diagonal, como en las demás secciones -->
    <img
        src="/imagenes/flores2.png"
        alt=""
        aria-hidden="true"
        class="ramo ramo-si"
    />
    <img
        src="/imagenes/flores2.png"
        alt=""
        aria-hidden="true"
        class="ramo ramo-id"
    />

    <div
        id="bloque-historia-corta"
        class="relative flex flex-col items-center text-center"
    >
        <h2 class="titulo font-great-vibes">
            {titulo}
            <svg class="corazon" viewBox="0 0 32 29" aria-hidden="true">
                <path
                    d="M16 28.5 3.6 16.4C.4 13.3.4 8.2 3.6 5.1a8 8 0 0 1 11.2 0l1.2 1.2 1.2-1.2a8 8 0 0 1 11.2 0c3.2 3.1 3.2 8.2 0 11.3L16 28.5z"
                ></path>
            </svg>
        </h2>

        <p class="texto font-cormorant">
            {primero.map((linea) => <span class="renglon">{linea}</span>)}
        </p>

        <p class="texto cierre font-cormorant">
            {segundoInicio}
            <span class="resalte">{segundoResalte}</span>
        </p>

        <svg class="corazon corazon-pie" viewBox="0 0 32 29" aria-hidden="true">
            <path
                d="M16 28.5 3.6 16.4C.4 13.3.4 8.2 3.6 5.1a8 8 0 0 1 11.2 0l1.2 1.2 1.2-1.2a8 8 0 0 1 11.2 0c3.2 3.1 3.2 8.2 0 11.3L16 28.5z"
            ></path>
        </svg>
    </div>
</section>

<style>
    #nuestra-historia {
        --terracota: #a4482a;
        --tinta: #7a3418;
    }

    /* Filete fino, como el impreso de la invitación */
    .filete {
        position: absolute;
        inset: 14px;
        border: 1px solid rgba(164, 72, 42, 0.3);
        pointer-events: none;
    }

    /* ── Ramos de las esquinas ── */
    .ramo {
        position: absolute;
        width: 30%;
        height: auto;
        z-index: 0;
        pointer-events: none;
        user-select: none;
    }

    .ramo-si {
        top: 0;
        left: -13%;
        transform: scaleY(-1) rotate(4deg);
    }

    .ramo-id {
        bottom: 0;
        right: -13%;
        transform: scaleX(-1) rotate(4deg);
    }

    /* ── Título ── */
    .titulo {
        color: var(--terracota);
        font-weight: 400;
        font-size: clamp(2.1rem, 9.6vw, 2.7rem);
        line-height: 1.25;
    }

    /*
       El corazón acompaña al título en la misma línea. Va dimensionado en
       em y no en px para que crezca y se achique junto con la caligrafía.
    */
    .corazon {
        display: inline-block;
        width: 0.62em;
        height: 0.57em;
        margin-left: 0.2em;
        vertical-align: 0.02em;
        fill: var(--terracota);
    }

    /* ── Texto ── */
    .texto {
        color: var(--tinta);
        font-size: clamp(1.15rem, 5.3vw, 1.4rem);
        line-height: 1.75;
        margin-top: 1.5rem;
    }

    .renglon {
        display: block;
    }

    .cierre {
        margin-top: 1.7rem;
    }

    .resalte {
        font-weight: 700;
    }

    /* El del pie va suelto y más chico: es un remate, no parte del texto */
    .corazon-pie {
        width: 1.15rem;
        height: 1.05rem;
        margin: 1.5rem 0 0;
    }
</style>

<script>
    import { animarEntrada } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const bloque = document.getElementById("bloque-historia-corta");
        if (bloque) animarEntrada(bloque.children, bloque);
    });
</script>
