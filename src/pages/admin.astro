---
// src/pages/admin.astro
// Panel de administración de invitados. Tema oscuro, tipografía de sistema.
// No comparte estilos con la invitación: es una herramienta, no papelería.
---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070b11" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/iconos/Anillos.png" />
    <title>Panel de invitados · Marvin &amp; Carla</title>

    <style is:global>
      /* ═══════════════════════════════════════════════════════════
         TEMA OSCURO
         Sin Tailwind aquí: el panel es una herramienta aparte y así
         no arrastra el CSS de la invitación ni pelea con su paleta.
         ═══════════════════════════════════════════════════════════ */
      :root {
        --fondo:         #070b11;
        --panel:         #0e141d;
        --panel-alto:    #141c27;
        --borde:         #1f2b3a;
        --borde-suave:   #172231;
        --texto:         #e3edf5;
        --texto-tenue:   #7d8fa5;
        --neon:          #00f5a0;
        --neon-claro:    #5cffc4;
        --neon-fondo:    rgba(0, 245, 160, 0.12);
        --neon-brillo:   rgba(0, 245, 160, 0.35);
        --peligro:       #ff4d6d;
        --peligro-fondo: rgba(255, 77, 109, 0.12);
        --sombra:        0 4px 20px rgba(0, 0, 0, 0.55);
        --radio:         9px;

        color-scheme: dark;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      html, body { height: 100%; }

      body {
        background: var(--fondo);
        color: var(--texto);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto,
                     "Helvetica Neue", Arial, sans-serif;
        font-size: 15px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      button, input, select { font: inherit; color: inherit; }
      button { cursor: pointer; background: none; border: none; }
      .oculto { display: none !important; }

      /* ── Campos ── */
      .campo {
        width: 100%;
        background: var(--fondo);
        border: 1px solid var(--borde);
        border-radius: var(--radio);
        padding: 0.6rem 0.85rem;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
      }
      .campo:focus {
        border-color: var(--neon);
        box-shadow: 0 0 0 3px var(--neon-fondo);
      }
      .campo::placeholder { color: #56637a; }

      /* Se ve que no se toca: apagado y sin cursor de escritura */
      .campo-bloqueado {
        opacity: 0.55;
        cursor: not-allowed;
        border-style: dashed;
      }
      .campo-bloqueado:focus {
        border-color: var(--borde);
        box-shadow: none;
      }
      .nota-campo {
        font-size: 0.72rem;
        color: var(--texto-tenue);
        margin-top: 0.3rem;
      }

      .etiqueta {
        display: block;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--texto-tenue);
        margin-bottom: 0.4rem;
      }

      /* ── Botones ── */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border-radius: var(--radio);
        padding: 0.55rem 1.1rem;
        font-size: 0.9rem;
        font-weight: 500;
        white-space: nowrap;
        transition: background .15s, border-color .15s, opacity .15s;
      }
      .btn:disabled { opacity: .5; cursor: not-allowed; }

      .btn-neon {
        background: var(--neon);
        color: #04120c;
        font-weight: 600;
        box-shadow: 0 0 14px var(--neon-brillo);
      }
      .btn-neon:hover:not(:disabled) {
        background: var(--neon-claro);
        box-shadow: 0 0 22px var(--neon-brillo);
      }

      .btn-linea      { border: 1px solid var(--borde); color: var(--texto-tenue); }
      .btn-linea:hover{ border-color: var(--neon); color: var(--neon); background: var(--neon-fondo); }

      .btn-peligro    { border: 1px solid rgba(255,77,109,.4); color: var(--peligro); }
      .btn-peligro:hover { background: var(--peligro-fondo); border-color: var(--peligro); }

      .btn-chico { padding: 0.35rem 0.7rem; font-size: 0.8rem; }

      /* ── Tarjetas ── */
      .tarjeta {
        background: var(--panel);
        border: 1px solid var(--borde-suave);
        border-radius: 14px;
        box-shadow: var(--sombra);
      }
      .tarjeta-cabecera {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--borde-suave);
      }
      .tarjeta-titulo {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--neon);
      }
      .tarjeta-cuerpo { padding: 1.25rem; }

      /* ═══ ESTRUCTURA ═══ */
      .disposicion { display: flex; min-height: 100vh; }

      /* ── Barra lateral ── */
      .lateral {
        position: fixed;
        inset: 0 auto 0 0;
        width: 250px;
        background: var(--panel);
        border-right: 1px solid var(--borde-suave);
        display: flex;
        flex-direction: column;
        z-index: 40;
        transform: translateX(-100%);
        transition: transform .25s ease;
      }
      .lateral.abierta { transform: translateX(0); }

      .lateral-marca {
        padding: 1.25rem;
        border-bottom: 1px solid var(--borde-suave);
      }
      .lateral-marca strong {
        display: block;
        font-size: 1rem;
        letter-spacing: 0.02em;
      }
      .lateral-marca span {
        display: block;
        font-size: 0.75rem;
        color: var(--texto-tenue);
        margin-top: 0.15rem;
      }

      .lateral-menu { padding: 0.75rem; flex: 1; }
      .lateral-item {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        width: 100%;
        padding: 0.65rem 0.8rem;
        border-radius: var(--radio);
        color: var(--texto-tenue);
        font-size: 0.92rem;
        text-align: left;
        transition: background .15s, color .15s;
      }
      .lateral-item:hover { background: var(--panel-alto); color: var(--texto); }
      .lateral-item.activo {
        position: relative;
        background: var(--neon-fondo);
        color: var(--neon);
        font-weight: 500;
      }
      .lateral-item.activo::before {
        content: "";
        position: absolute;
        left: 0; top: 20%; bottom: 20%;
        width: 3px;
        border-radius: 999px;
        background: var(--neon);
        box-shadow: 0 0 10px var(--neon-brillo);
      }
      .lateral-item svg { width: 18px; height: 18px; flex-shrink: 0; }

      .lateral-pie {
        padding: 0.75rem;
        border-top: 1px solid var(--borde-suave);
        font-size: 0.78rem;
        color: var(--texto-tenue);
      }

      .velo {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        z-index: 35;
      }

      /* ── Zona principal ── */
      .principal { flex: 1; min-width: 0; display: flex; flex-direction: column; }

      .superior {
        position: sticky;
        top: 0;
        z-index: 30;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.85rem 1rem;
        background: rgba(14, 20, 29, 0.92);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--borde-suave);
      }
      .superior h1 { font-size: 1rem; font-weight: 600; }

      .icono-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px; height: 38px;
        border-radius: var(--radio);
        color: var(--texto-tenue);
        flex-shrink: 0;
      }
      .icono-btn:hover { background: var(--panel-alto); color: var(--texto); }
      .icono-btn svg { width: 20px; height: 20px; }

      .contenido {
        padding: 1.25rem 1rem 3rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 1100px;
        width: 100%;
        margin: 0 auto;
      }

      /* ── Cajas de resumen ── */
      .resumen { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.85rem; }
      .caja-num {
        background: var(--panel);
        border: 1px solid var(--borde-suave);
        border-left: 3px solid var(--neon);
        border-radius: 14px;
        padding: 1rem 1.15rem;
      }
      .caja-num span {
        display: block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--texto-tenue);
      }
      .caja-num strong {
        display: block;
        font-size: 1.9rem;
        font-weight: 600;
        line-height: 1.2;
        margin-top: 0.2rem;
      }

      /* ── Interruptor ── */
      .fila-switch {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        cursor: pointer;
      }
      .switch { position: relative; width: 46px; height: 26px; flex-shrink: 0; }
      .switch input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
      .switch i {
        position: absolute;
        inset: 0;
        background: #33404f;
        border-radius: 999px;
        transition: background .2s;
        pointer-events: none;
      }
      .switch i::after {
        content: "";
        position: absolute;
        top: 3px; left: 3px;
        width: 20px; height: 20px;
        background: #fff;
        border-radius: 50%;
        transition: transform .2s;
      }
      .switch input:checked + i {
        background: var(--neon);
        box-shadow: 0 0 12px var(--neon-brillo);
      }
      .switch input:checked + i::after { transform: translateX(20px); }

      /* ── Avisos ── */
      .aviso {
        border-radius: 14px;
        padding: 0.9rem 1.1rem;
        font-size: 0.9rem;
        border: 1px solid;
      }
      .aviso-atencion {
        background: var(--neon-fondo);
        border-color: rgba(0,245,160,.35);
        color: var(--neon-claro);
      }
      .aviso-error {
        background: var(--peligro-fondo);
        border-color: rgba(255,77,109,.35);
        color: var(--peligro);
      }

      /* ── Formulario de alta ── */
      .form-alta { display: grid; gap: 0.85rem; }

      /* ── Tabla ── */
      .tabla { width: 100%; border-collapse: collapse; }
      .tabla th {
        text-align: left;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--texto-tenue);
        font-weight: 600;
        padding: 0.7rem 0.8rem;
        border-bottom: 1px solid var(--borde-suave);
        background: var(--panel-alto);
      }
      .tabla td {
        /* Apretado a proposito: con 1.25rem por lado, siete columnas se
           comian 300px solo en aire y la fila no entraba en pantalla */
        padding: 0.7rem 0.8rem;
        border-bottom: 1px solid var(--borde-suave);
        vertical-align: middle;
      }
      /* La columna de acciones no se parte nunca */
      .tabla td.col-acciones { white-space: nowrap; width: 1%; }
      .tabla tr:last-child td { border-bottom: none; }
      .tabla tbody tr:hover { background: var(--panel-alto); }

      .celda-nombre { font-weight: 500; }
      /*
         Solo el codigo, no la direccion entera.

         El link completo medía 250px de columna para decir siete veces lo
         mismo: el dominio se repite en todas las filas y lo unico que
         cambia son los cinco caracteres del final. Con la direccion entera
         la fila no entraba y "Editar" y "Borrar" quedaban fuera de
         pantalla.

         Nadie lo tipea a mano: para eso estan los dos botones que lo
         copian. Sirve para reconocer de que invitado es un link, y para
         eso alcanza el codigo. El completo queda en el title, al pasar
         el mouse por encima.
      */
      .celda-link {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.82rem;
        color: var(--texto-tenue);
        white-space: nowrap;
      }
      .pastilla {
        display: inline-block;
        background: var(--neon-fondo);
        color: var(--neon);
        border-radius: 999px;
        padding: 0.15rem 0.65rem;
        font-size: 0.82rem;
        font-weight: 600;
      }
      /*
         Los acompañantes van debajo del titular, en la columna del nombre.

         Antes estaban en la columna "Asisten", que mide 110px: un
         "josema pérez gonzález lópez" no entra ahí ni ensanchándola, y
         quedaba partido en pedazos. Esta columna es la más ancha de la
         tabla y no tiene ancho fijo, así que el nombre entra entero.

         Y es donde corresponde: son gente de esa misma invitación, no un
         dato aparte. El sangrado y el ícono los muestran colgando del
         titular sin necesidad de rótulo.
      */
      .acompanantes {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        margin-top: 0.4rem;
        padding-left: 0.1rem;
      }
      .acompanante {
        display: flex;
        align-items: flex-start;
        gap: 0.4rem;
        font-size: 0.82rem;
        font-weight: 400;
        line-height: 1.35;
        color: var(--texto-tenue);
      }
      /* El ícono no se achica ni se estira cuando el nombre ocupa dos
         renglones: queda alineado con el primero */
      .acompanante svg {
        width: 13px;
        height: 13px;
        flex: none;
        margin-top: 0.18rem;
        color: var(--neon);
        opacity: 0.7;
      }

      /* ── Barra de herramientas de la lista ── */
      .herramientas-lista {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
      }
      .filtros {
        display: flex;
        gap: 0.35rem;
      }
      /* El filtro activo se marca en neon, como el item del menu */
      .filtros .activo {
        border-color: var(--neon);
        color: var(--neon);
        background: var(--neon-fondo);
      }
      @media (max-width: 620px) {
        .herramientas-lista {
          width: 100%;
        }
        .herramientas-lista .campo,
        #btn-exportar {
          flex: 1;
        }
      }

      /* ── Lista de buenos deseos ── */
      .lista-deseos {
        display: grid;
        gap: 0.85rem;
      }
      .deseo-fila {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 0.9rem 1rem;
        border: 1px solid var(--borde-suave);
        border-radius: 10px;
        background: var(--panel-alto);
      }
      .deseo-cuerpo {
        flex: 1;
        min-width: 0;
      }
      .deseo-nombre {
        color: var(--neon);
        font-weight: 600;
        font-size: 0.92rem;
      }
      .deseo-fecha {
        color: var(--texto-tenue);
        font-size: 0.78rem;
        margin-left: 0.5rem;
      }
      .deseo-mensaje {
        color: var(--texto);
        font-size: 0.92rem;
        line-height: 1.55;
        margin-top: 0.3rem;
        /* Los mensajes traen saltos de linea del textarea */
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
      @media (max-width: 560px) {
        .deseo-fila {
          flex-direction: column;
        }
      }

      /* Quien confirmo se tiene que ver de un vistazo, sin leer */
      .pastilla.si {
        background: var(--neon-fondo);
        color: var(--neon);
      }
      .pastilla.no {
        background: transparent;
        border: 1px solid var(--borde);
        color: var(--texto-tenue);
        font-weight: 500;
      }
      /* En escritorio los botones van en una sola línea. Antes se envolvían
         en columna y dejaban las filas larguísimas. */
      .acciones {
        display: flex;
        flex-wrap: nowrap;
        gap: 0.4rem;
        justify-content: flex-end;
      }

      .vacio { padding: 2.5rem 1.25rem; text-align: center; color: var(--texto-tenue); }

      /* ── La tabla se vuelve tarjetas en pantallas chicas ── */
      @media (max-width: 767px) {
        .tabla thead { display: none; }
        .tabla, .tabla tbody, .tabla tr, .tabla td { display: block; width: 100%; }
        .tabla tr {
          border: 1px solid var(--borde-suave);
          border-radius: 12px;
          padding: 0.85rem 1rem;
          margin-bottom: 0.75rem;
          background: var(--fondo);
        }
        .tabla td { border: none; padding: 0.3rem 0; }
        .tabla td::before {
          content: attr(data-rotulo);
          display: block;
          font-size: 0.68rem;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          color: var(--texto-tenue);
          margin-bottom: 0.15rem;
        }
        .acciones { flex-wrap: wrap; justify-content: flex-start; margin-top: 0.7rem; }
        .tabla td.col-acciones { width: auto; white-space: normal; }
        .celda-link { max-width: 100%; white-space: normal; word-break: break-all; }
      }

      /* ── Ventanas modales ── */
      .modal-fondo {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        z-index: 60;
      }
      .modal {
        background: var(--panel);
        border: 1px solid var(--borde);
        border-radius: 14px;
        box-shadow: 0 20px 50px rgba(0,0,0,.6);
        width: 100%;
        max-width: 420px;
      }
      .modal-cabecera {
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid var(--borde-suave);
        font-weight: 600;
      }
      .modal-cuerpo { padding: 1.25rem; display: grid; gap: 0.85rem; }
      /* ── Importar desde Excel ── */
      .mapeo-columnas {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 0.7rem;
      }
      .mapeo-columnas label {
        display: block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--texto-tenue);
        margin-bottom: 0.3rem;
      }
      /* La previa se desplaza sola si el archivo trae muchas filas */
      .vista-previa {
        max-height: 15rem;
        overflow: auto;
        border: 1px solid var(--borde-suave);
        border-radius: var(--radio);
      }
      .tabla-previa th,
      .tabla-previa td { padding: 0.45rem 0.7rem; font-size: 0.85rem; }
      .tabla-previa thead th { position: sticky; top: 0; }

      .modal-pie {
        padding: 1rem 1.25rem;
        border-top: 1px solid var(--borde-suave);
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
      }

      /* ── Aviso flotante ── */
      .toast {
        position: fixed;
        left: 50%;
        bottom: 1.5rem;
        transform: translateX(-50%);
        background: var(--panel-alto);
        border: 1px solid var(--borde);
        color: var(--texto);
        border-radius: 999px;
        padding: 0.6rem 1.25rem;
        font-size: 0.88rem;
        box-shadow: var(--sombra);
        opacity: 0;
        pointer-events: none;
        transition: opacity .25s;
        z-index: 70;
      }
      .toast.visible { opacity: 1; }

      /* ── Login ── */
      .login-pantalla {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
      }
      .login-caja { width: 100%; max-width: 370px; }
      .login-marca { text-align: center; margin-bottom: 1.5rem; }
      .login-marca strong { display: block; font-size: 1.15rem; }
      .login-marca span {
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--texto-tenue);
        margin-top: 0.3rem;
      }
      .login-rombo {
        width: 8px; height: 8px;
        background: var(--neon);
        box-shadow: 0 0 14px var(--neon-brillo);
        transform: rotate(45deg);
        margin: 0 auto 1rem;
      }

      /* ═══ ESCRITORIO ═══ */
      @media (min-width: 1024px) {
        .lateral { transform: translateX(0); }
        .principal { margin-left: 250px; }
        .velo, #btn-menu { display: none; }
        .contenido { padding: 1.75rem 2rem 3rem; }
        .resumen { grid-template-columns: repeat(4, 1fr); }
        /*
           Cinco columnas, sin hueco al final:
           nombre · pases · mesa · idioma · boton

           Eran cuatro y al sumarse el campo de mesa quedaron cinco cosas
           en cuatro lugares, asi que el boton se caia al renglon de abajo.

           El nombre va en 1fr: los otros cuatro tienen el ancho que
           necesitan —son un numero, un numero y una lista— y todo lo que
           sobra se lo queda el nombre, que es el unico dato largo. Asi la
           fila llega hasta el borde y el boton queda pegado a la derecha,
           sin espacio muerto.
        */
        .form-alta {
          grid-template-columns: 1fr 90px 125px 130px auto;
          align-items: end;
        }
      }
    </style>
  </head>

  <body>

    <!-- ═══ CARGANDO ═══ -->
    <div id="pantalla-carga" class="login-pantalla">
      <div style="text-align: center; max-width: 420px">
        <p id="carga-texto" style="color: var(--texto-tenue)">Cargando…</p>
        <div id="carga-error" class="aviso aviso-error oculto" style="text-align: left"></div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- LOGIN                                                    -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div id="pantalla-login" class="login-pantalla oculto">
      <div class="login-caja">
