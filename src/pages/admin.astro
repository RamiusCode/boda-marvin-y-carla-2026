    <!-- ═══ MODAL BORRAR ═══ -->
    <!-- ═══ IMPORTAR DESDE EXCEL ═══
         Esta pantalla es el seguro. El sistema adivina qué columna es
         cuál, y casi siempre acierta, pero si se equivoca crearía 50
         invitados con la mesa y los pases cambiados, y eso se deshace de
         a uno. Acá se ve antes de tocar la base, y se corrige. -->
    <div id="modal-importar" class="modal-fondo oculto">
      <div class="modal" style="max-width: 44rem">
        <div class="modal-cabecera">Importar invitados</div>
        <div class="modal-cuerpo">
          <p id="importar-resumen"></p>

          <!-- Los desplegables se llenan con las columnas del archivo -->
          <div id="importar-mapeo" class="mapeo-columnas"></div>

          <div class="vista-previa">
            <table class="tabla tabla-previa">
              <thead>
                <tr>
                  <th>Invitado</th>
                  <th style="width: 80px">Pases</th>
                  <th style="width: 80px">Mesa</th>
                  <th style="width: 90px">Idioma</th>
                </tr>
              </thead>
              <tbody id="importar-filas"></tbody>
            </table>
          </div>

          <p id="importar-descartadas" class="aviso aviso-error oculto"></p>
          <p id="importar-error" class="aviso aviso-error oculto"></p>
        </div>
        <div class="modal-pie">
          <button type="button" class="btn btn-linea" data-cerrar-modal>Cancelar</button>
          <button type="button" id="btn-confirmar-importar" class="btn btn-neon">
            Importar
          </button>
        </div>
      </div>
    </div>

    <div id="modal-borrar" class="modal-fondo oculto">
      <div class="modal">
        <div class="modal-cabecera">Borrar invitado</div>
        <div class="modal-cuerpo">
          <p>¿Seguro que quieres borrar a <strong id="borrar-nombre"></strong>?</p>
          <p style="font-size: .87rem; color: var(--texto-tenue)">
            Su link dejará de funcionar. Esto no se puede deshacer.
          </p>
          <p id="borrar-error" class="aviso aviso-error oculto"></p>
        </div>
        <div class="modal-pie">
          <button type="button" class="btn btn-linea" data-cerrar-modal>Cancelar</button>
          <button type="button" id="btn-borrar-confirmar" class="btn btn-peligro">Borrar</button>
        </div>
      </div>
    </div>

    <div id="toast" class="toast"></div>

    <script>
      import { supabase, configurado, generarCodigo, linkInvitado } from "../lib/supabase";

      // ── Estado ──
      let invitados = [];
      let esAdmin = false;
      let registroAbierto = true;
      let filtro = "";
      let enEdicion = null;
      let enBorrado = null;

      const $ = (id) => document.getElementById(id);
      const ver = (el, visible) => el.classList.toggle("oculto", !visible);

      // ── Aviso flotante ──
      let tiempoToast;
      function avisar(texto) {
        const t = $("toast");
        t.textContent = texto;
        t.classList.add("visible");
        clearTimeout(tiempoToast);
        tiempoToast = setTimeout(() => t.classList.remove("visible"), 2400);
      }

      function mostrarError(id, mensaje) {
        const el = $(id);
        el.textContent = mensaje || "";
        ver(el, Boolean(mensaje));
      }

      function pantalla(cual) {
        for (const p of ["pantalla-carga", "pantalla-login", "pantalla-panel"]) {
          ver($(p), p === cual);
        }
      }

      // ═══ BARRA LATERAL (móvil) ═══
      function menuLateral(abrir) {
        $("lateral").classList.toggle("abierta", abrir);
        ver($("velo"), abrir);
      }
      $("btn-menu").addEventListener("click", () => menuLateral(true));
      $("velo").addEventListener("click", () => menuLateral(false));

      // ═══ LOGIN ═══
      $("form-login").addEventListener("submit", async (e) => {
        e.preventDefault();
        mostrarError("login-error", "");
        $("btn-login").disabled = true;

        const { error } = await supabase.auth.signInWithPassword({
          email: $("login-email").value.trim(),
          password: $("login-pass").value,
        });

        $("btn-login").disabled = false;

        if (error) {
          mostrarError(
            "login-error",
            error.message === "Invalid login credentials"
              ? "Correo o contraseña incorrectos."
              : error.message
          );
          return;
        }
        await entrarAlPanel();
      });

      $("btn-salir").addEventListener("click", async () => {
        await supabase.auth.signOut();
        location.reload();
      });

      // ═══ CARGA DEL PANEL ═══
      async function entrarAlPanel() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          pantalla("pantalla-login");
          return;
        }

        $("sesion-email").textContent = session.user.email;

        const [perfil, ajustes] = await Promise.all([
          supabase.from("perfiles").select("rol").eq("id", session.user.id).maybeSingle(),
          supabase.from("ajustes").select("registro_abierto").eq("id", 1).maybeSingle(),
        ]);

        esAdmin = perfil.data?.rol === "admin";
        registroAbierto = ajustes.data?.registro_abierto ?? true;

        $("sesion-rol").textContent = esAdmin ? "Administrador" : "Novios";
        ver($("caja-admin"), esAdmin);
        $("switch-registro").checked = registroAbierto;

        aplicarPermisos();
        pantalla("pantalla-panel");
        await cargarInvitados();
        await cargarDeseos();
        escucharCambios();
      }

      // ═══ TIEMPO REAL ═══
      /*
         Supabase avisa por un canal abierto cuando algo cambia en la base,
         asi que el panel se entera solo: si un invitado confirma desde su
         celular, la pastilla se pone verde sin tocar F5.

         Se vuelve a pedir la lista entera en vez de parchear la fila que
         cambio. Con listas de boda -decenas, no miles- la consulta es
         instantanea, y evita toda una familia de errores: filas duplicadas,
         contadores desfasados, borrados que no se reflejan.

         El respiro de 300 ms junta los avisos que llegan en rafaga. Sin el,
         cargar diez invitados de una dispara diez consultas seguidas.
      */
      let respiroInvitados = 0;
      let respiroDeseos = 0;

      function escucharCambios() {
        supabase
          .channel("panel")
          .on(
            "postgres_changes",
            { event: "*", schema: "public", table: "invitados" },
            () => {
              clearTimeout(respiroInvitados);
              respiroInvitados = setTimeout(cargarInvitados, 300);
            }
          )
          .on(
            "postgres_changes",
            { event: "*", schema: "public", table: "deseos" },
            () => {
              clearTimeout(respiroDeseos);
              respiroDeseos = setTimeout(cargarDeseos, 300);
            }
          )
          .subscribe();
      }

      // ═══ VISTAS ═══
      /*
         Dos vistas dentro de la misma página: invitados y deseos. Se
         alternan escondiendo bloques en vez de navegar, así no hay que
         volver a pedirle la sesión a Supabase en cada cambio.
      */
      let vistaActual = "invitados";

      function cambiarVista(cual) {
        vistaActual = cual;

        document.querySelectorAll(".lateral-item").forEach((b) => {
          b.classList.toggle("activo", b.dataset.vista === cual);
        });

        const esInvitados = cual === "invitados";
        ver($("resumen-invitados"), esInvitados);
        ver($("caja-admin"), esInvitados && esAdmin);
        ver($("caja-form"), esInvitados && puedeEditar());
        ver($("aviso-cerrado"), esInvitados && !puedeEditar());
        ver($("caja-lista"), esInvitados);
        ver($("vista-deseos"), !esInvitados);

        // En celular la barra lateral tapa el contenido: se cierra sola
        $("lateral").classList.remove("abierta");
        ver($("velo"), false);
      }

      document.querySelectorAll(".lateral-item").forEach((b) => {
        b.addEventListener("click", () => cambiarVista(b.dataset.vista));
      });

      // ═══ FILTRO DE ASISTENCIA ═══
      let filtroAsistencia = "todos";

      document.querySelectorAll("[data-filtro]").forEach((b) => {
        b.addEventListener("click", () => {
          filtroAsistencia = b.dataset.filtro;
          document.querySelectorAll("[data-filtro]").forEach((otro) => {
            otro.classList.toggle("activo", otro === b);
          });
          pintarLista();
        });
      });

      // ═══ DESCARGAR LA LISTA ═══
      /*
         Se baja un CSV y no un PDF: Excel lo abre directo con doble clic, y
         además el cliente puede ordenar y filtrar. Un PDF se lee pero no se
         trabaja, y encima obligaría a sumar una librería de 200 KB al panel.

         Se exporta LO QUE SE ESTÁ VIENDO: si el filtro está en
         "Confirmaron", baja solo esos.
      */
      function descargarLista() {
        const texto = ($("buscador").value || "").trim().toLowerCase();
        const filas = invitados
          .filter((i) => (texto ? i.nombre.toLowerCase().includes(texto) : true))
          .filter((i) =>
            filtroAsistencia === "si" ? i.confirmado
            : filtroAsistencia === "no" ? !i.confirmado
            : true
          );

        if (filas.length === 0) {
          avisar("No hay nada para descargar");
          return;
        }

        // Las comillas dobles dentro de un campo se escapan duplicándolas
        const celda = (v) => '"' + String(v == null ? "" : v).split('"').join('""') + '"';

        /*
           Solo nombre y pases. El link no sirve en una planilla -no se
           puede tocar desde Excel- y la columna de asistencia sobra:
           si se exporta con el filtro en "Confirmaron", todas las filas
           dicen lo mismo.
        */
        const cabecera = ["Invitado", "Pases", "Asisten", "Acompanantes", "Mesa"];
        const cuerpo = filas.map((i) =>
          [
            celda(i.nombre),
            celda(i.pases),
            celda(i.confirmado ? (i.asisten ?? i.pases) : ""),
            celda(Array.isArray(i.acompanantes) ? i.acompanantes.filter(Boolean).join(", ") : ""),
            celda(i.mesa),
          ].join(";")
        );

        /*
           Punto y coma y no coma: el Excel en español usa ; como separador,
           y con coma mete todo en una sola columna.

           El ﻿ del principio le avisa a Excel que el archivo es UTF-8;
           sin eso los acentos y las eñes salen rotos.
        */
        const csv = "﻿" + [cabecera.map(celda).join(";")].concat(cuerpo).join("\r\n");

        const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        const sufijo =
          filtroAsistencia === "si" ? "-confirmados"
          : filtroAsistencia === "no" ? "-sin-responder"
          : "";
        a.href = url;
        a.download = "invitados-marvin-carla" + sufijo + ".csv";
        a.click();
        URL.revokeObjectURL(url);

        avisar("Descargados " + filas.length + " invitados");
      }

      $("btn-exportar").addEventListener("click", descargarLista);

      // ═══════════════════════════════════════════════════════
      // IMPORTAR DESDE EXCEL
      // ═══════════════════════════════════════════════════════
      /*
         El cliente aprieta un botón, elige su archivo y ve lo que se va a
         crear. No tiene que acomodar nada antes: las columnas se ubican
         por el nombre del encabezado, en el orden que estén.
      */

      // Lo que puede haber escrito en cada encabezado. Se compara sin
      // acentos, sin mayúsculas y sin espacios de sobra.
      const ALIAS = {
        nombre: ["nombre", "nombres", "invitado", "invitados", "familia",
                 "apellido", "apellidos", "nombre y apellido"],
        pases: ["pases", "pase", "cupos", "cupo", "cantidad", "personas",
                "acompanantes", "tickets", "boletos"],
        mesa: ["mesa", "mesas", "nro mesa", "n mesa", "numero de mesa",
               "num mesa"],
        idioma: ["idioma", "lengua", "language", "lang"],
      };

      // "Nº Mesa " y "nro mesa" tienen que dar lo mismo
      const normalizar = (t) =>
        String(t ?? "")
          .normalize("NFD")
          .replace(/[̀-ͯ]/g, "")
          .replace(/[^a-z0-9 ]/gi, " ")
          .replace(/\s+/g, " ")
          .trim()
          .toLowerCase();

      // Lo que quedó leído del archivo, esperando confirmación
      let importable = null;

      $("btn-importar").addEventListener("click", () => {
        // Se limpia para que elegir el mismo archivo dos veces vuelva a
        // disparar el change
        $("archivo-excel").value = "";
        $("archivo-excel").click();
      });

      $("archivo-excel").addEventListener("change", async (e) => {
        const archivo = e.target.files?.[0];
        if (!archivo) return;

        try {
          /*
             La librería se carga recién acá y no con la página: son
             cientos de kilobytes que solo hacen falta el día que se
             importa una lista, no cada vez que se abre el panel.
          */
          const XLSX = await import("xlsx");
          const buffer = await archivo.arrayBuffer();
          const libro = XLSX.read(buffer, { type: "array" });
          const hoja = libro.Sheets[libro.SheetNames[0]];

          // Como matriz y no como objetos: hace falta ver los encabezados
          // crudos para poder reconocerlos.
          const filas = XLSX.utils.sheet_to_json(hoja, {
            header: 1,
            blankrows: false,
            defval: "",
          });

          prepararImportacion(filas);
        } catch (err) {
          avisar("No se pudo leer el archivo");
        }
      });

      /*
         Busca la fila de encabezados y ubica cada columna.

         No se asume que sea la primera: es muy común que arriba haya un
         título o una fila vacía. Se toma la primera fila donde se
         reconozcan al menos dos de las columnas conocidas.
      */
      function prepararImportacion(filas) {
        let iCabecera = -1;
        let mapa = null;

        for (let i = 0; i < Math.min(filas.length, 15); i++) {
          const posible = ubicarColumnas(filas[i]);
          const cuantas = Object.values(posible).filter((v) => v >= 0).length;
          if (posible.nombre >= 0 && cuantas >= 2) {
            iCabecera = i;
            mapa = posible;
            break;
          }
        }

        if (!mapa) {
          avisar("No encontré los encabezados (Nombre, Pases…)");
          return;
        }

        importable = {
          cabecera: filas[iCabecera],
          cuerpo: filas.slice(iCabecera + 1),
          mapa,
        };

        pintarImportacion();
        ver($("modal-importar"), true);
      }

      function ubicarColumnas(fila) {
        const encontrado = { nombre: -1, pases: -1, mesa: -1, idioma: -1 };
        if (!Array.isArray(fila)) return encontrado;

        fila.forEach((celda, i) => {
          const texto = normalizar(celda);
          if (!texto) return;
          for (const campo of Object.keys(ALIAS)) {
            if (encontrado[campo] >= 0) continue;
            if (ALIAS[campo].includes(texto)) encontrado[campo] = i;
          }
        });
        return encontrado;
      }

      // ═══ Vista previa ═══
      function pintarImportacion() {
        const { cabecera, mapa } = importable;
        const listas = leerFilasImportadas();

        $("importar-resumen").textContent =
          "Encontré " + listas.buenas.length + " invitados en el archivo.";

        // Un desplegable por campo, para corregir si adivinó mal
        const cont = $("importar-mapeo");
        cont.textContent = "";
        const rotulos = {
          nombre: "Nombre", pases: "Pases", mesa: "Mesa", idioma: "Idioma",
        };
        for (const campo of Object.keys(rotulos)) {
          const caja = document.createElement("div");
          const etiqueta = document.createElement("label");
          etiqueta.textContent = rotulos[campo];
          const select = document.createElement("select");
          select.className = "campo";

          const vacia = document.createElement("option");
          vacia.value = "-1";
          vacia.textContent = campo === "nombre" ? "— elegir —" : "— sin usar —";
          select.append(vacia);

          cabecera.forEach((celda, i) => {
            const op = document.createElement("option");
            op.value = String(i);
            // Si la columna no tiene título se la nombra por su lugar
            op.textContent = String(celda ?? "").trim() || "Columna " + (i + 1);
            select.append(op);
          });

          select.value = String(mapa[campo]);
          select.addEventListener("change", () => {
            mapa[campo] = Number(select.value);
            pintarImportacion();
          });

          caja.append(etiqueta, select);
          cont.append(caja);
        }

        // Las primeras filas, ya interpretadas
        const cuerpo = $("importar-filas");
        cuerpo.textContent = "";
        for (const inv of listas.buenas.slice(0, 30)) {
          const tr = document.createElement("tr");
          for (const valor of [
            inv.nombre,
            inv.pases,
            inv.mesa ?? "—",
            inv.idioma,
          ]) {
            const td = document.createElement("td");
            td.textContent = String(valor);
            tr.append(td);
          }
          cuerpo.append(tr);
        }

        /*
           Las filas con problemas no frenan la importación: se cargan las
           buenas y se avisa cuáles quedaron afuera. Con cincuenta filas,
           rechazar todo el archivo por un dato mal escrito obliga a
           empezar de nuevo sin saber dónde estaba el error.
        */
        const aviso = $("importar-descartadas");
        if (listas.malas.length) {
          aviso.textContent =
            "Quedan afuera " + listas.malas.length + " fila(s): " +
            listas.malas.slice(0, 5).join(" · ") +
            (listas.malas.length > 5 ? " …" : "");
          ver(aviso, true);
        } else {
          ver(aviso, false);
        }

        $("btn-confirmar-importar").disabled = listas.buenas.length === 0;
      }

      /*
         Traduce las filas crudas a invitados, separando las que sirven de
         las que no. Se llama en cada repintado para que corregir un
         desplegable actualice la previa al instante.
      */
      function leerFilasImportadas() {
        const { cuerpo, mapa } = importable;
        const buenas = [];
        const malas = [];

        cuerpo.forEach((fila, i) => {
          const linea = i + 1;
          const celda = (col) =>
            col >= 0 ? String(fila?.[col] ?? "").trim() : "";

          const nombre = celda(mapa.nombre);
          // Fila vacía: se saltea sin avisar, no es un error del cliente
          if (!nombre && !celda(mapa.pases) && !celda(mapa.mesa)) return;

          if (!nombre) {
            malas.push("fila " + linea + ": sin nombre");
            return;
          }

          // Sin columna de pases, o vacía, se asume 1
          const textoPases = celda(mapa.pases);
          const pases = textoPases === "" ? 1 : Number(textoPases);
          if (!Number.isInteger(pases) || pases < 1 || pases > 20) {
            malas.push("fila " + linea + ": pases “" + textoPases + "”");
            return;
          }

          // La mesa es opcional: vacía queda sin asignar
          const textoMesa = celda(mapa.mesa);
          let mesa = null;
          if (textoMesa !== "") {
            const n = Number(textoMesa);
            if (!Number.isInteger(n) || n < 1 || n > 200) {
              malas.push("fila " + linea + ": mesa “" + textoMesa + "”");
              return;
            }
            mesa = n;
          }

          // Cualquier cosa que empiece con "en" o "in" es inglés
          const textoIdioma = normalizar(celda(mapa.idioma));
          const idioma = /^(en|in)/.test(textoIdioma) ? "en" : "es";

          buenas.push({ nombre: nombre.slice(0, 80), pases, mesa, idioma });
        });

        return { buenas, malas };
      }

      // ═══ Guardar ═══
      $("btn-confirmar-importar").addEventListener("click", async () => {
        if (!importable) return;
        const { buenas } = leerFilasImportadas();
        if (!buenas.length) return;

        const boton = $("btn-confirmar-importar");
        boton.disabled = true;
        mostrarError("importar-error", "");

        let cargados = 0;
        const fallados = [];

        /*
           De a uno y no todos juntos: el código es aleatorio y puede
           chocar con uno existente. Fila por fila se reintenta solo la
           que chocó, en vez de perder las cincuenta.
        */
        for (const inv of buenas) {
          let guardado = null;

          for (let intento = 0; intento < 5; intento++) {
            const { data, error } = await supabase
              .from("invitados")
              .insert({ codigo: generarCodigo(), ...inv })
              .select("id, codigo, nombre, pases, confirmado, confirmado_en, idioma, mesa, asisten, acompanantes")
              .single();

            if (!error) { guardado = data; break; }
            if (error.code !== "23505") {   // 23505 = código repetido
              fallados.push(inv.nombre);
              break;
            }
          }

          if (guardado) {
            invitados.unshift(guardado);
            cargados++;
            boton.textContent = "Importando… " + cargados + "/" + buenas.length;
          }
        }

        boton.textContent = "Importar";
        boton.disabled = false;
        importable = null;
        cerrarModales();
        pintarLista();

        avisar(
          fallados.length
            ? cargados + " cargados · " + fallados.length + " con error"
            : cargados + " invitados cargados"
        );
      });

      // ═══ CORREGIR UNA CONFIRMACIÓN ═══
      /*
         El modal de la invitación evita el toque sin querer, pero los
         planes cambian: alguien confirma en octubre y en enero no puede.
         Que lo corrija el cliente desde acá es más natural que poner un
         "ya no voy" en la invitación.
      */
      async function desmarcar(inv) {
        if (!confirm("¿Marcar a " + inv.nombre + " como sin responder?")) return;

        const { error } = await supabase
          .from("invitados")
          // Se borra tambien lo que habia respondido: dejarlo seria guardar
          // "no respondio" y "vienen 2" al mismo tiempo.
          .update({
            confirmado: false,
            confirmado_en: null,
            asisten: null,
            acompanantes: null,
          })
          .eq("id", inv.id);

        if (error) {
          avisar("No se pudo actualizar");
          return;
        }
        inv.confirmado = false;
        inv.confirmado_en = null;
        inv.asisten = null;
        inv.acompanantes = null;
        cerrarModales();
        pintarLista();
        avisar("Marcado como sin responder");
      }

      // Se dispara desde el modal de editar, no desde la fila
      $("btn-desmarcar").addEventListener("click", () => {
        if (enEdicion) desmarcar(enEdicion);
      });

      // ═══ BUENOS DESEOS ═══
      let deseos = [];

      async function cargarDeseos() {
        const { data, error } = await supabase
          .from("deseos")
          .select("id, nombre, mensaje, creado_en")
          .order("creado_en", { ascending: false });

        if (error) {
          avisar("No se pudieron cargar los deseos");
          return;
        }
        deseos = data ?? [];
        pintarDeseos();
      }

      function pintarDeseos() {
        const caja = $("lista-deseos");
        caja.innerHTML = "";

        $("total-deseos").textContent = String(deseos.length);
        ver($("deseos-vacio"), deseos.length === 0);

        for (const d of deseos) {
          const fila = document.createElement("div");
          fila.className = "deseo-fila";

          const cuerpo = document.createElement("div");
          cuerpo.className = "deseo-cuerpo";

          const cabecera = document.createElement("div");
          const nombre = document.createElement("span");
          nombre.className = "deseo-nombre";
          nombre.textContent = d.nombre;

          const fecha = document.createElement("span");
          fecha.className = "deseo-fecha";
          fecha.textContent = new Date(d.creado_en).toLocaleDateString("es-BO", {
            day: "numeric", month: "short", hour: "2-digit", minute: "2-digit",
          });

          cabecera.append(nombre, fecha);

          const mensaje = document.createElement("div");
          mensaje.className = "deseo-mensaje";
          /*
             textContent y nunca innerHTML: esto lo escribió un invitado.
             Armar el HTML por concatenación sería dejar que alguien meta
             etiquetas en su "deseo".
          */
          mensaje.textContent = d.mensaje;

          cuerpo.append(cabecera, mensaje);
          fila.append(cuerpo);

          /*
             Lo ven los dos roles, no solo el admin.

             La boda es de los novios y el muro se publica en su
             invitación: si alguien deja un mensaje fuera de lugar, tienen
             que poder sacarlo ellos y no depender de que otro lo haga.

             Es además lo que la base ya permitía: la política de borrado
             de "deseos" habilita a cualquiera que esté logueado, así que
             el candado estaba solo en la pantalla. Ahora los dos lados
             dicen lo mismo.
          */
          const borrar = document.createElement("button");
          borrar.type = "button";
          borrar.className = "btn btn-chico btn-peligro";
          borrar.textContent = "Borrar";
          borrar.addEventListener("click", () => borrarDeseo(d));
          fila.append(borrar);

          caja.append(fila);
        }
      }

      async function borrarDeseo(deseo) {
        if (!confirm("¿Borrar el deseo de " + deseo.nombre + "?")) return;

        const { error } = await supabase.from("deseos").delete().eq("id", deseo.id);
        if (error) {
          avisar("No se pudo borrar");
          return;
        }
        deseos = deseos.filter((d) => d.id !== deseo.id);
        pintarDeseos();
        avisar("Deseo borrado");
      }

      // El admin siempre puede; los novios solo con el registro abierto
      const puedeEditar = () => esAdmin || registroAbierto;

      /*
         Los permisos se aplican repintando la vista activa. Si tocaran los
         bloques directamente, apagar el interruptor estando en "Buenos
         deseos" haría reaparecer el formulario de invitados por detrás.
      */
      function aplicarPermisos() {
        cambiarVista(vistaActual);
      }

      // ═══ INTERRUPTOR DEL ADMIN ═══
      $("switch-registro").addEventListener("change", async (e) => {
        const valor = e.target.checked;
        const { error } = await supabase
          .from("ajustes").update({ registro_abierto: valor }).eq("id", 1);

        if (error) {
          e.target.checked = !valor;
          avisar("No se pudo cambiar");
          return;
        }
        registroAbierto = valor;
        aplicarPermisos();
        pintarLista();
        avisar(valor ? "Registro abierto" : "Registro cerrado");
      });

      /*
         El campo de mesa puede quedar vacío, y vacío no es cero: quiere
         decir "todavía sin asignar" y va como null a la base. Devuelve
         "invalida" en vez de null cuando hay algo escrito que no sirve,
         porque si no un "abc" se guardaría como si el campo estuviera
         vacío y el cliente creería que borró la mesa a propósito.
      */
      function leerMesa(id) {
        const crudo = $(id).value.trim();
        if (crudo === "") return null;
        const n = Number(crudo);
        if (!Number.isInteger(n) || n < 1 || n > 200) return "invalida";
        return n;
      }

      // ═══ DATOS ═══
      async function cargarInvitados() {
        const { data, error } = await supabase
          .from("invitados")
          .select("id, codigo, nombre, pases, confirmado, confirmado_en, idioma, mesa, asisten, acompanantes")
          .order("creado_en", { ascending: false });

        if (error) {
          avisar("No se pudo cargar la lista");
          return;
        }
        invitados = data ?? [];
        pintarLista();
      }

      function traducirError(error) {
        if (error.code === "42501" || /row-level security/i.test(error.message)) {
          return "El registro de invitados está cerrado.";
        }
        return error.message;
      }

      // ── Alta ──
      $("form-invitado").addEventListener("submit", async (e) => {
        e.preventDefault();
        mostrarError("form-error", "");

        const nombre = $("in-nombre").value.trim();
        const pases = Number($("in-pases").value);
        const idioma = $("in-idioma").value;
        const mesa = leerMesa("in-mesa");

        if (!nombre) return;
        if (!Number.isInteger(pases) || pases < 1 || pases > 20) {
          mostrarError("form-error", "Los pases deben ser un número del 1 al 20.");
          return;
        }
        if (mesa === "invalida") {
          mostrarError("form-error", "La mesa debe ser un número del 1 al 200, o quedar vacía.");
          return;
        }

        $("btn-guardar").disabled = true;

        // El código es aleatorio: si choca con uno existente, se reintenta
        let guardado = null;
        for (let intento = 0; intento < 5; intento++) {
          const { data, error } = await supabase
            .from("invitados")
            .insert({ codigo: generarCodigo(), nombre, pases, idioma, mesa })
            .select("id, codigo, nombre, pases, confirmado, confirmado_en, idioma, mesa, asisten, acompanantes")
            .single();

          if (!error) { guardado = data; break; }
          if (error.code !== "23505") {      // 23505 = código repetido
            mostrarError("form-error", traducirError(error));
            break;
          }
        }

        $("btn-guardar").disabled = false;
        if (!guardado) return;

        invitados.unshift(guardado);
        $("in-nombre").value = "";
        $("in-pases").value = "2";
        $("in-mesa").value = "";
        $("in-idioma").value = "es";
        $("in-nombre").focus();
        pintarLista();
        avisar("Invitado agregado");
      });

      // ── Modales ──
      for (const btn of document.querySelectorAll("[data-cerrar-modal]")) {
        btn.addEventListener("click", cerrarModales);
      }
      for (const fondo of [$("modal-editar"), $("modal-borrar")]) {
        fondo.addEventListener("click", (e) => {
          if (e.target === fondo) cerrarModales();
        });
      }
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") cerrarModales();
      });

      function cerrarModales() {
        ver($("modal-editar"), false);
        ver($("modal-borrar"), false);
        ver($("modal-importar"), false);
        mostrarError("editar-error", "");
        mostrarError("borrar-error", "");
        mostrarError("importar-error", "");
        enEdicion = null;
        enBorrado = null;
        // Se suelta lo leído del archivo: si vuelve a abrir, empieza de cero
        importable = null;
      }

      function abrirEditar(inv) {
        enEdicion = inv;
        $("ed-nombre").value = inv.nombre;
        $("ed-pases").value = String(inv.pases);

        /*
           Los pases se pueden cambiar mientras el invitado no haya
           respondido. En cuanto confirma quedan fijos, y no es un capricho:
           su respuesta se guardó contra ese número. Bajarlos por debajo de
           lo que confirmó dejaba la fila diciendo "3 / 2", que es
           imposible, y encima contaba 3 en el total con el que se reserva.

           Si de verdad hay que cambiarlos, primero se lo marca como sin
           responder desde el botón de abajo y ahí el campo se libera.
        */
        const trabado = Boolean(inv.confirmado);
        const campoPases = $("ed-pases");
        campoPases.readOnly = trabado;
        campoPases.tabIndex = trabado ? -1 : 0;
        campoPases.classList.toggle("campo-bloqueado", trabado);
        ver($("nota-pases"), trabado);
        // Sin mesa asignada el campo va vacío, no en cero
        $("ed-mesa").value = inv.mesa == null ? "" : String(inv.mesa);
        $("ed-idioma").value = inv.idioma || "es";
        ver($("btn-desmarcar"), Boolean(inv.confirmado));
        mostrarError("editar-error", "");
        ver($("modal-editar"), true);
        $("ed-nombre").focus();
      }

      $("form-editar").addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!enEdicion) return;

        const nombre = $("ed-nombre").value.trim();
        const pases = Number($("ed-pases").value);
        const idioma = $("ed-idioma").value;
        const mesa = leerMesa("ed-mesa");

        if (!nombre || !Number.isInteger(pases) || pases < 1 || pases > 20) {
          mostrarError("editar-error", "Revisa el nombre y que los pases estén entre 1 y 20.");
          return;
        }
        if (mesa === "invalida") {
          mostrarError("editar-error", "La mesa debe ser un número del 1 al 200, o quedar vacía.");
          return;
        }

        const { error } = await supabase
          .from("invitados").update({ nombre, pases, idioma, mesa }).eq("id", enEdicion.id);

        if (error) {
          mostrarError("editar-error", traducirError(error));
          return;
        }

        /*
           Se copia lo guardado a la fila que ya está en memoria: la lista
           se repinta desde ahí, sin volver a pedirle todo a la base.
           El idioma faltaba y por eso un cambio de idioma no se veía en el
           link de la lista hasta recargar la página.
        */
        enEdicion.nombre = nombre;
        enEdicion.pases = pases;
        enEdicion.idioma = idioma;
        enEdicion.mesa = mesa;
        cerrarModales();
        pintarLista();
        avisar("Actualizado — el link sigue sirviendo");
      });

      function abrirBorrar(inv) {
        enBorrado = inv;
        $("borrar-nombre").textContent = inv.nombre;
        mostrarError("borrar-error", "");
        ver($("modal-borrar"), true);
      }

      $("btn-borrar-confirmar").addEventListener("click", async () => {
        if (!enBorrado) return;

        const { error } = await supabase.from("invitados").delete().eq("id", enBorrado.id);
        if (error) {
          mostrarError("borrar-error", traducirError(error));
          return;
        }

        invitados = invitados.filter((x) => x.id !== enBorrado.id);
        cerrarModales();
        pintarLista();
        avisar("Invitado borrado");
      });

      // ── Compartir ──
      async function copiar(texto, aviso = "Mensaje copiado") {
        try {
          await navigator.clipboard.writeText(texto);
        } catch {
          // Safari y contextos sin permiso de portapapeles
          const campo = document.createElement("textarea");
          campo.value = texto;
          campo.style.position = "fixed";
          campo.style.opacity = "0";
          document.body.appendChild(campo);
          campo.select();
          document.execCommand("copy");
          campo.remove();
        }
        avisar(aviso);
      }

      // Mensaje listo para pegar en WhatsApp.
      // Los *asteriscos* son la negrita de WhatsApp: se ven en negrita al enviarlo.
      /*
         El mensaje de WhatsApp también sale en el idioma del invitado: no
         tiene sentido mandarle la invitación en inglés con un texto de
         presentación en español.
      */
      const MENSAJES = {
        es: [
          "*Con el corazón lleno de amor*",
          "",
          "Hemos decidido unir nuestras vidas y dar el paso más importante de nuestra historia.",
          "Queremos compartir este momento tan especial con las personas que más queremos.",
          "",
          "Será un honor contar con tu presencia en nuestro gran día. 🤍",
          "",
          "*Haz clic en el enlace para ver nuestra invitación*",
          "",
          "{link}",
          "",
          "¡Te esperamos para celebrar juntos este hermoso comienzo!",
        ],
        en: [
          "*With our hearts full of love*",
          "",
          "We have decided to join our lives and take the most important step of our story.",
          "We would love to share this special moment with the people we care about the most.",
          "",
          "It would be an honour to have you with us on our big day. 🤍",
          "",
          "*Tap the link to see our invitation*",
          "",
          "{link}",
          "",
          "We look forward to celebrating this beautiful beginning together!",
        ],
      };

      function mensajeInvitacion(inv) {
        const idioma = inv.idioma === "en" ? "en" : "es";
        return MENSAJES[idioma]
          .join("\n")
          .replace("{link}", linkInvitado(inv.codigo, idioma));
      }

      // ═══ PINTAR LA LISTA ═══
      function pintarLista() {
        const cuerpo = $("lista");
        cuerpo.innerHTML = "";

        const texto = filtro.trim().toLowerCase();
        const visibles = invitados
          .filter((i) => (texto ? i.nombre.toLowerCase().includes(texto) : true))
          .filter((i) =>
            filtroAsistencia === "si" ? i.confirmado
            : filtroAsistencia === "no" ? !i.confirmado
            : true
          );

        $("total-invitados").textContent = String(invitados.length);
        $("total-pases").textContent = String(invitados.reduce((s, i) => s + i.pases, 0));

        /*
           Se cuentan personas y asistentes: al cliente le sirven los dos
           numeros para calcular la comida y las sillas.

           Suma 'asisten' y no 'pases'. Son cosas distintas: 'pases' es
           cuantos lugares se ofrecieron, 'asisten' cuantos dijeron que
           vienen. Sumar pases inflaba el total con los lugares que la
           gente devolvio al venir sola, y sobre ese numero se reserva.

           El fallback a 'pases' cubre a quien confirmo antes de que
           existiera la pregunta y no tiene el dato cargado.
        */
        const confirmados = invitados.filter((i) => i.confirmado);
        const totalAsisten = confirmados.reduce(
          (s, i) => s + (i.asisten ?? i.pases),
          0
        );
        $("total-confirmados").textContent =
          confirmados.length + " (" + totalAsisten + " asisten)";
        ver($("lista-vacia"), visibles.length === 0);

        const permitido = puedeEditar();

        for (const inv of visibles) {
          // El link lleva el idioma del invitado: el cliente copia y manda,
          // sin tener que acordarse de nada.
          const link = linkInvitado(inv.codigo, inv.idioma);
          const fila = document.createElement("tr");

          const tdNombre = document.createElement("td");
          tdNombre.dataset.rotulo = "Invitado";
          tdNombre.className = "celda-nombre";

          const titular = document.createElement("div");
          titular.textContent = inv.nombre;
          tdNombre.append(titular);

          /*
             Debajo del titular, quienes lo acompañan. Solo tiene sentido
             mostrarlos si confirmó: antes de eso lo que haya guardado es
             de una respuesta vieja que ya no vale.
          */
          const acompanan =
            inv.confirmado && Array.isArray(inv.acompanantes)
              ? inv.acompanantes.filter(Boolean)
              : [];

          if (acompanan.length) {
            const lista = document.createElement("div");
            lista.className = "acompanantes";

            for (const quien of acompanan) {
              const fila = document.createElement("div");
              fila.className = "acompanante";
              // El monigote se arma acá y no se copia de un <template>
              // porque cloneNode de un SVG en una tabla trae menos lío
              // que mantener un nodo suelto en el HTML.
              fila.insertAdjacentHTML(
                "afterbegin",
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
                  'stroke-width="2" stroke-linecap="round" ' +
                  'stroke-linejoin="round" aria-hidden="true">' +
                  '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>' +
                  '<circle cx="12" cy="7" r="4"/></svg>'
              );
              const texto = document.createElement("span");
              // textContent y no innerHTML: el nombre lo escribió un
              // invitado desde su celular, no es HTML de confianza.
              texto.textContent = quien;
              fila.append(texto);
              lista.append(fila);
            }
            tdNombre.append(lista);
          }

          const tdPases = document.createElement("td");
          tdPases.dataset.rotulo = "Pases";
          const pastilla = document.createElement("span");
          pastilla.className = "pastilla";
          pastilla.textContent = String(inv.pases);
          tdPases.append(pastilla);

          /*
             Sin mesa se pone una raya y no una pastilla vacía: de un
             vistazo se ve a quién falta ubicar cuando se arme el salón.
          */
          const tdMesa = document.createElement("td");
          tdMesa.dataset.rotulo = "Mesa";
          if (inv.mesa == null) {
            tdMesa.textContent = "—";
            tdMesa.style.color = "var(--texto-tenue)";
          } else {
            const chapa = document.createElement("span");
            chapa.className = "pastilla";
            chapa.textContent = String(inv.mesa);
            tdMesa.append(chapa);
          }

          /*
             Cuantos vienen de los que se ofrecieron, en "1 / 2". El par
             importa mas que el numero suelto: un "1" no dice nada, un
             "1 / 2" grita que quedo un lugar libre.

             Los nombres de los acompanantes van debajo, en chico: sirven
             para las tarjetas de mesa y son opcionales, asi que muchos van
             a estar vacios.
          */
          const tdAsisten = document.createElement("td");
          tdAsisten.dataset.rotulo = "Asisten";
          if (!inv.confirmado) {
            tdAsisten.textContent = "—";
            tdAsisten.style.color = "var(--texto-tenue)";
          } else {
            const vienen = inv.asisten ?? inv.pases;
            const par = document.createElement("span");
            // Se destaca solo cuando no vienen todos: es el caso que
            // obliga al cliente a rehacer una cuenta.
            par.className = vienen < inv.pases ? "pastilla no" : "pastilla si";
            par.textContent = vienen + " / " + inv.pases;
            tdAsisten.append(par);
          }

          // Confirmó o no. Es lo primero que el cliente va a mirar
          // cuando falten dos semanas para la boda.
          const tdConfirmo = document.createElement("td");
          tdConfirmo.dataset.rotulo = "Asistencia";
          const marca = document.createElement("span");
          marca.className = inv.confirmado ? "pastilla si" : "pastilla no";
          marca.textContent = inv.confirmado ? "Confirmó" : "Sin responder";
          if (inv.confirmado && inv.confirmado_en) {
            marca.title =
              "Confirmó el " +
              new Date(inv.confirmado_en).toLocaleDateString("es-BO", {
                day: "numeric", month: "long", hour: "2-digit", minute: "2-digit",
              });
          }
          tdConfirmo.append(marca);

          const tdLink = document.createElement("td");
          tdLink.dataset.rotulo = "Código";
          tdLink.className = "celda-link";
          tdLink.textContent = inv.codigo;
          // El link entero, al pasar el mouse por encima
          tdLink.title = link;

          const tdAcciones = document.createElement("td");
          tdAcciones.className = "col-acciones";
          const acciones = document.createElement("div");
          acciones.className = "acciones";

          const boton = (etiqueta, clase, alPulsar) => {
            const b = document.createElement("button");
            b.type = "button";
            b.textContent = etiqueta;
            b.className = `btn btn-chico ${clase}`;
            b.addEventListener("click", alPulsar);
            return b;
          };

          acciones.append(
            boton("Copiar mensaje", "btn-neon", () => copiar(mensajeInvitacion(inv))),
            boton("Solo link", "btn-linea", () => copiar(link, "Link copiado"))
          );

          if (permitido) {
            acciones.append(
              boton("Editar", "btn-linea", () => abrirEditar(inv)),
              boton("Borrar", "btn-peligro", () => abrirBorrar(inv))
            );
          }

          tdAcciones.append(acciones);
          fila.append(tdNombre, tdPases, tdMesa, tdAsisten, tdConfirmo, tdLink, tdAcciones);
          cuerpo.append(fila);
        }
      }

      $("buscador").addEventListener("input", (e) => {
        filtro = e.target.value;
        pintarLista();
      });

      // ═══ ARRANQUE ═══
      function fallo(titulo, detalle) {
        $("carga-texto").classList.add("oculto");
        const caja = $("carga-error");
        caja.innerHTML =
          "<strong>" + titulo + "</strong><br><span style='opacity:.85'>" + detalle + "</span>";
        caja.classList.remove("oculto");
      }

      (async () => {
        // Sin variables de entorno no hay nada que hacer: avisar en vez
        // de dejar la pantalla colgada en "Cargando…"
        if (!configurado) {
          fallo(
            "Falta la configuración de Supabase",
            "Las variables PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_KEY no llegaron al build. " +
            "Agrégalas en Vercel → Settings → Environment Variables y vuelve a desplegar " +
            "(Deployments → ⋯ → Redeploy)."
          );
          return;
        }

        try {
          const { data: { session } } = await supabase.auth.getSession();
          if (session) await entrarAlPanel();
          else pantalla("pantalla-login");
        } catch (e) {
          fallo("No se pudo conectar con la base de datos", String(e?.message || e));
        }
      })();
    </script>
  </body>
</html>
