---
// src/components/CeremoniaReligiosa.astro
// Ceremonia religiosa sobre el papel de acuarela: la hora, el dibujo de la
// iglesia, el nombre del templo con su dirección y el botón al mapa.
//
// Al ir sobre fondo claro todo va en terracota, al revés que la recepción,
// que es un bloque de color con el texto en crema. Por lo mismo esta
// sección no lleva los corazones flotantes: son crema y no se verían.
// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Ceremonia Religiosa";
const hora = "14:00";
const rotulo = "Parroquia";
const templo = ["NUESTRA SEÑORA", "DE POMPEYA"];
const direccion = [
    "Calle Jamaica esquina calle Cuba",
    "( Zona Miraflores )",
];
const mapa = "https://maps.app.goo.gl/hptrPVszhB98Gjc67";
const textoBoton = "Ver mapa";
// ──────────────────────────────────────────────────────────────
---

<section id="ceremonia-religiosa" class="relative w-full overflow-hidden">
    <!-- Fondo de acuarela -->
    <img
        src="/imagenes/foto3.png"
        alt=""
        width="935"
        height="1629"
        aria-hidden="true"
        class="absolute inset-0 h-full w-full object-cover"
    />

    <!--
       Filete impreso. Va antes que los ramos en el markup a propósito: sin
       z-index propio, el orden del documento decide, y así las flores le
       pasan por encima como en la papelería de verdad.
    -->
    <span class="filete" aria-hidden="true"></span>

    <!--
       Ramos en dos esquinas opuestas: el overflow-hidden de la sección los
       corta contra el filo, que es lo que los deja entrando en cuadro en
       vez de flotando sueltos.
    -->
    <img
        src="/imagenes/flores2.png"
        alt=""
        aria-hidden="true"
        class="ramo ramo-si"
    />
    <img
        src="/imagenes/flores2.png"
        alt=""
        aria-hidden="true"
        class="ramo ramo-id"
    />

    <div
        id="bloque-religiosa"
        class="relative flex flex-col items-center px-7 py-16 text-center"
    >
        <h2 class="font-great-vibes titulo-religiosa">{titulo}</h2>

        <p class="hora-religiosa">
            <!-- El reloj se pinta con máscara, no con filtros -->
            <span
                class="icono icono-terracota reloj-religiosa"
                style="--ic:url('/imagenes/hora.png')"
                aria-hidden="true"></span>
            <span class="font-cormorant hora-texto">{hora}</span>
        </p>

        <span class="separador" aria-hidden="true">
            <i class="raya"></i>
            <b class="corazon">&#9829;</b>
            <i class="raya"></i>
        </span>

        <!-- El dibujo también va con máscara: el trazo negro no se vería -->
        <span
            class="icono icono-terracota dibujo-iglesia"
            style="--ic:url('/imagenes/iglesia.png')"
            aria-hidden="true"></span>

        <p class="font-great-vibes rotulo-templo">{rotulo}</p>

        <h3 class="font-cormorant nombre-templo">
            {templo.map((linea) => <span class="block">{linea}</span>)}
        </h3>

        <p class="font-cormorant direccion-templo">
            {direccion.map((linea) => <span class="block">{linea}</span>)}
        </p>

        <a
            href={mapa}
            target="_blank"
            rel="noopener noreferrer"
            class="font-cormorant boton-mapa"
        >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="pin-mapa">
                <path
                    d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"
                    fill="currentColor"></path>
            </svg>
            {textoBoton}
        </a>
    </div>
</section>

<style>
    .titulo-religiosa {
        color: #a4482a;
        font-size: clamp(2.1rem, 9.6vw, 2.7rem);
        line-height: 1.25;
    }

    .hora-religiosa {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        margin-top: 0.4rem;
        color: #8e3a1e;
    }

    /* Filete fino, como el impreso de la invitación */
    .filete {
        position: absolute;
        inset: 14px;
        border: 1px solid rgba(164, 72, 42, 0.3);
        pointer-events: none;
    }

    /*
       ── Ramos de las esquinas ──
       En dos esquinas opuestas y no en las cuatro: sobre un bloque de color
       claro, dos alcanzan para dar el detalle sin cargar el cuadro.
       z-index 0 los deja detrás del texto, que va en .relative.
    */
    .ramo {
        position: absolute;
        width: 32%;
        height: auto;
        z-index: 0;
        pointer-events: none;
        user-select: none;
    }

    .ramo-si {
        top: 0;
        left: -13%;
        transform: scaleY(-1) rotate(4deg);
    }

    .ramo-id {
        bottom: 0;
        right: -13%;
        transform: scaleX(-1) rotate(4deg);
    }

    .reloj-religiosa {
        width: 1.5rem;
        height: 1.5rem;
        flex: none;
    }

    /* Rayita · corazón · rayita, el mismo remate del resto de la invitación */
    .separador {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.1rem;
    }

    .raya {
        display: block;
        width: 2.2rem;
        height: 1px;
        background: rgba(164, 72, 42, 0.5);
    }

    .corazon {
        color: #a4482a;
        font-size: 0.7rem;
        line-height: 1;
        font-weight: 400;
    }

    .hora-texto {
        font-size: clamp(1.4rem, 6.4vw, 1.75rem);
        font-weight: 600;
        letter-spacing: 0.03em;
        /* Cifras de caja alta: las de estilo antiguo bailan de altura */
        font-variant-numeric: lining-nums;
    }

    .dibujo-iglesia {
        width: 62%;
        max-width: 250px;
        /* La proporción del dibujo es 811x630 */
        aspect-ratio: 811 / 630;
        margin-top: 1rem;
    }

    .rotulo-templo {
        color: #a05a3c;
        font-size: clamp(1.15rem, 5.2vw, 1.4rem);
        line-height: 1.3;
        margin-top: 0.9rem;
    }

    .nombre-templo {
        color: #7a3418;
        font-size: clamp(1.35rem, 6.2vw, 1.7rem);
        font-weight: 600;
        letter-spacing: 0.06em;
        /* text-indent compensa el hueco que el tracking deja después de la
           última letra; sin esto el renglón se ve corrido a la izquierda */
        text-indent: 0.06em;
        line-height: 1.35;
        margin-top: 0.2rem;
    }

    /* Mismo tamaño y estilo que la dirección de la recepción, en terracota
       porque acá el fondo es el papel claro. */
    .direccion-templo {
        color: #a05a3c;
        font-size: clamp(1.15rem, 5.3vw, 1.4rem);
        line-height: 1.55;
        margin-top: 0.9rem;
    }

    /*
       El botón del modelo: fondo claro, texto oscuro y forma de hoja: en
       punta arriba a la izquierda y abajo a la derecha, redondeado en las
       otras dos esquinas.
    */
    .boton-mapa {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        margin-top: 1.8rem;
        padding: 0.7rem 1.8rem;
        border-radius: 2px 24px 2px 24px;
        background: #e6c4ad;
        color: #7a3418;
        font-size: clamp(1rem, 4.6vw, 1.2rem);
        font-weight: 600;
        letter-spacing: 0.03em;
        box-shadow: 0 5px 14px rgba(90, 40, 22, 0.16);
        transition: transform 0.3s ease;
    }

    .boton-mapa:hover {
        transform: scale(1.04);
    }

    .pin-mapa {
        width: 1.15em;
        height: 1.15em;
        flex: none;
    }
</style>

<script>
    import { animarEntrada } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const bloque = document.getElementById("bloque-religiosa");
        if (bloque) animarEntrada(bloque.children, bloque);
    });
</script>
